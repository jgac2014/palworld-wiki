---
/**
 * Índice filtrável de uma coleção importada.
 *
 * Serve item, estrutura e tecnologia com o mesmo componente porque as três são
 * a mesma coisa: lista de nome nos dois idiomas mais uns poucos campos. A
 * decisão de 31.07 do PRD é que elas NÃO ganham página por registro: seriam
 * 2.959 páginas e o build passaria de dois minutos.
 *
 * O paldb lista o dado bruto do jogo, e parte dele nunca aparece em tela, com
 * nome tipo "NPC_WEAPON". Essas ficam escondidas por padrão, mas continuam no
 * HTML: a página diz quantas são e por quê, e um checkbox mostra. Esconder sem
 * dizer é o que o CLAUDE.md chama de corte silencioso.
 *
 * GRADE E NÃO TABELA, desde a F4 em 01.08.2026. Eram tabelas de uma e de duas
 * colunas de texto curto, e a tabela é que produzia o desperdício: /itens tinha
 * 1.875 linhas e 116 mil pixels de altura com metade da tela em branco ao lado,
 * e alargar a página só mudava o vazio de lugar, abrindo um vão de 800px entre
 * "Nome" e "Categoria" em /estruturas. Nome curto pede coluna estreita e muitas
 * colunas, que é grade. Os campos de dado viram uma linha de metadados dentro
 * do próprio cartão, com o rótulo junto do valor, porque fora de tabela um
 * número solto não diz do que é.
 *
 * As tabelas que o R5.8 exige continuam onde elas significam alguma coisa, que
 * é ao lado de visualização: as calculadoras e a de poder de captura.
 */
import { ui } from '../lib/termos.js';
import { enderecoItem } from '../lib/enderecos.js';

interface Props {
  itens: any[];
  // Rota da ficha de cada registro, quando ela existe. Sem isto o índice é um
  // beco sem saída: 1.875 nomes onde clicar não leva a lugar nenhum.
  //
  // É opcional porque as três coleções não andam juntas. Os itens ganharam
  // ficha na E9; estrutura e tecnologia ganham na E11, e até lá o índice delas
  // continua sendo lista. Linkar antes da rota existir produziria 1.084 links
  // para páginas não geradas, que é o defeito que a asserção 4 já pega.
  rota?: string;
  // `campoEn` é opcional e existe para o VALOR da coluna alternar de idioma,
  // não só o rótulo dela. Sem isso a coluna TIPO de /tecnologias saía com o
  // "Items" e "Structures" crus do paldb no meio de nome, nível e custo em
  // português, e a categoria de /estruturas ficava presa no português mesmo
  // com o site em inglês.
  colunas?: { campo: string; campoEn?: string; chaveRotulo: string }[];
  subtituloChave: string;
}

const { itens, colunas = [], subtituloChave, rota } = Astro.props;

// Entrada interna do jogo se reconhece pelo nome: identificador cru não tem
// espaço e tem underscore, porque ninguém escreveu uma tradução para ele.
const ehInterno = (x: any) => /_/.test(x.en);
const internos = itens.filter(ehInterno).length;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (x: any) => (rota ? `${base}/${rota}/${enderecoItem(x.chave)}/` : null);
---

<p class="subtitulo" data-rot-pt={ui(subtituloChave, 'pt')} data-rot-en={ui(subtituloChave, 'en')}>{ui(subtituloChave, 'pt')}</p>

<div class="controles">
  <input
    type="search"
    id="filtro"
    placeholder={ui('indice_filtro', 'pt')}
    data-ph-pt={ui('indice_filtro', 'pt')}
    data-ph-en={ui('indice_filtro', 'en')}
  />
  {internos > 0 && (
    <label class="mostrar-internos">
      <input type="checkbox" id="internos" />
      <span data-rot-pt={ui('indice_internos', 'pt')} data-rot-en={ui('indice_internos', 'en')}>{ui('indice_internos', 'pt')}</span>
    </label>
  )}
</div>

<p class="contagem" id="contagem"></p>

{internos > 0 && (
  <p class="nota-internos">
    <strong>{internos}</strong>{' '}
    <span data-rot-pt={ui('indice_internos_nota', 'pt')} data-rot-en={ui('indice_internos_nota', 'en')}>{ui('indice_internos_nota', 'pt')}</span>
  </p>
)}

<ul class="indice-grade" id="grade">
  {itens.map((x) => (
    <li
      data-interno={ehInterno(x) ? '1' : ''}
      data-busca={`${x.pt} ${x.en}`.toLowerCase()}
    >
      {href(x)
        ? <a class="nome" href={href(x)} data-rot-pt={x.pt} data-rot-en={x.en}>{x.pt}</a>
        : <span class="nome" data-rot-pt={x.pt} data-rot-en={x.en}>{x.pt}</span>}
      {x.pt !== x.en && <span class="en">{x.en}</span>}
      {/*
        O jogo não traduziu este nome, e a página diz isso em vez de
        exibir o inglês fingindo que é português. Antes daqui saía
        "pt-BR_Text", o marcador da string que falta, publicado como se
        fosse o nome da coisa.
      */}
      {x.sem_traducao_oficial && (
        <span
          class="sem-traducao"
          data-rot-pt={ui('indice_sem_traducao', 'pt')}
          data-rot-en={ui('indice_sem_traducao', 'en')}
        >{ui('indice_sem_traducao', 'pt')}</span>
      )}
      {colunas.length > 0 && (
        <span class="meta">
          {colunas.map((c) => (
            <span class="par">
              <span class="rot" data-rot-pt={ui(c.chaveRotulo, 'pt')} data-rot-en={ui(c.chaveRotulo, 'en')}>{ui(c.chaveRotulo, 'pt')}</span>
              {c.campoEn
                ? <span class="val" data-rot-pt={x[c.campo] ?? ''} data-rot-en={x[c.campoEn] ?? x[c.campo] ?? ''}>{x[c.campo] ?? ''}</span>
                : <span class="val">{x[c.campo] ?? ''}</span>}
            </span>
          ))}
        </span>
      )}
    </li>
  ))}
</ul>

<style>
  .controles { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; margin: 20px 0 10px; font-family: var(--sans); }
  .controles input[type="search"] {
    flex: 1; min-width: 220px; max-width: 520px;
    background: var(--cartao); border: 1px solid var(--linha); color: var(--texto);
    padding: 9px 12px; border-radius: 3px; font-size: 13.5px; font-family: var(--sans); outline: none;
  }
  .controles input[type="search"]:focus { border-color: var(--acento); }
  .mostrar-internos { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--texto-2); cursor: pointer; }
  .mostrar-internos input { accent-color: var(--acento); cursor: pointer; }
  .contagem { font-family: var(--sans); font-size: 12.5px; color: var(--apagado); margin-bottom: 4px; }
  .nota-internos { font-family: var(--sans); font-size: 12.5px; color: var(--apagado); margin-bottom: 14px; }

  .indice-grade {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(232px, 1fr));
    gap: 0 26px;
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--linha);
  }
  .indice-grade > li {
    padding: 8px 0;
    border-bottom: 1px solid var(--linha);
    font-size: 14.5px;
    min-width: 0;
  }
  .nome { overflow-wrap: anywhere; }
  .en { display: block; font-size: 12px; color: var(--apagado); font-family: var(--sans); overflow-wrap: anywhere; }
  .sem-traducao {
    display: block; font-size: 10.5px; letter-spacing: .06em; text-transform: uppercase;
    color: var(--atencao); font-family: var(--sans); margin-top: 2px;
  }
  .meta { display: flex; flex-wrap: wrap; gap: 2px 12px; margin-top: 3px; font-family: var(--sans); font-size: 11.5px; }
  /* Rótulo junto do valor: fora de tabela, "12" sozinho não diz se é nível ou custo. */
  .rot { color: var(--apagado); letter-spacing: .04em; text-transform: uppercase; font-size: 10px; }
  .val { color: var(--texto-2); margin-left: 4px; }
  .indice-grade > li.escondida { display: none; }
</style>

<script>
  const filtro = document.getElementById('filtro') as HTMLInputElement;
  const internos = document.getElementById('internos') as HTMLInputElement | null;
  const contagem = document.getElementById('contagem');
  const linhas = Array.from(document.querySelectorAll('#grade > li[data-busca]')) as HTMLElement[];

  function aplicar() {
    const t = filtro.value.trim().toLowerCase();
    const mostrarInternos = internos ? internos.checked : true;
    let visiveis = 0;
    for (const li of linhas) {
      const ok =
        (!t || (li.dataset.busca || '').includes(t)) &&
        (mostrarInternos || li.dataset.interno !== '1');
      li.classList.toggle('escondida', !ok);
      if (ok) visiveis++;
    }
    // A contagem diz sempre quantos de quantos, então esconder nunca é mudo.
    const pt = visiveis === linhas.length ? `${linhas.length} de ${linhas.length}` : `${visiveis} de ${linhas.length}`;
    const en = visiveis === linhas.length ? `${linhas.length} of ${linhas.length}` : `${visiveis} of ${linhas.length}`;
    if (contagem) {
      contagem.dataset.rotPt = pt;
      contagem.dataset.rotEn = en;
      contagem.textContent = document.documentElement.dataset.idioma === 'en' ? en : pt;
    }
  }

  filtro.addEventListener('input', aplicar);
  internos?.addEventListener('change', aplicar);
  aplicar();
</script>
