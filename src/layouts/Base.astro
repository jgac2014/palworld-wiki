---
import { getCollection } from 'astro:content';
import Search from 'astro-pagefind/components/Search.astro';
import Chat from '../components/Chat.astro';
import SeletorIdioma from '../components/SeletorIdioma.astro';
import { ui } from '../lib/termos.js';
import '../styles/global.css';

interface Props {
  titulo: string;
  descricao?: string;
  atualizado?: Date;
  arquivoFonte?: string;
}

const { titulo, descricao = '', atualizado, arquivoFonte } = Astro.props;

const paginas = (await getCollection('wiki', ({ data }) => !data.rascunho))
  .sort((a, b) => a.data.ordem - b.data.ordem);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const atual = Astro.url.pathname.replace(/\/$/, '');
const eh = (href: string) => atual === href.replace(/\/$/, '');

// Decisão 3.0 do PRD: as duas metades não se misturam na navegação. A wiki é
// pública e vale para qualquer jogador; o nosso mundo só vale para nós quatro.
const guias = paginas.filter((p) => p.data.camada !== 'nosso-mundo');
const doNossoMundo = paginas.filter((p) => p.data.camada === 'nosso-mundo');
// As páginas do nosso mundo só aparecem no menu de dentro da própria seção.
// De fora, quem chegou pelo Google vê a porta, não o conteúdo do nosso save.
const naSecao = eh(`${base}/nosso-mundo`) || doNossoMundo.some((p) => eh(`${base}/${p.id}`));

const REPO = 'https://github.com/nederreis/PalCrew';
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo} · Wiki Palworld 1.0</title>
  <meta name="description" content={descricao} />
  <meta property="og:title" content={`${titulo} · Wiki Palworld 1.0`} />
  <meta property="og:description" content={descricao} />
  <meta property="og:type" content="article" />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
</head>
<body>
<div class="casca">

  <nav class="lateral">
    <a
      class="marca"
      href={`${base}/`}
      data-rot-pt={ui('marca', 'pt')}
      data-rot-en={ui('marca', 'en')}
    >{ui('marca', 'pt')}</a>
    <SeletorIdioma />
    <div class="marca-sub">
      <span data-rot-pt={ui('marca_sub', 'pt')} data-rot-en={ui('marca_sub', 'en')}>{ui('marca_sub', 'pt')}</span><br />
      <span data-rot-pt={ui('marca_versao', 'pt')} data-rot-en={ui('marca_versao', 'en')}>{ui('marca_versao', 'pt')}</span> 1.0.2.101103
    </div>

    <div class="camada" data-rot-pt={ui('nav_camada_wiki', 'pt')} data-rot-en={ui('nav_camada_wiki', 'en')}>{ui('nav_camada_wiki', 'pt')}</div>

    <div class="grupo" data-rot-pt={ui('nav_ferramentas', 'pt')} data-rot-en={ui('nav_ferramentas', 'en')}>{ui('nav_ferramentas', 'pt')}</div>
    <a
      class="item"
      href={`${base}/mapa`}
      aria-current={eh(`${base}/mapa`) ? 'page' : undefined}
      data-rot-pt={ui('nav_mapa', 'pt')}
      data-rot-en={ui('nav_mapa', 'en')}
    >{ui('nav_mapa', 'pt')}</a>
    <a
      class="item"
      href={`${base}/pals`}
      aria-current={eh(`${base}/pals`) ? 'page' : undefined}
      data-rot-pt={ui('nav_pals', 'pt')}
      data-rot-en={ui('nav_pals', 'en')}
    >{ui('nav_pals', 'pt')}</a>

    <div class="grupo" data-rot-pt={ui('nav_guias', 'pt')} data-rot-en={ui('nav_guias', 'en')}>{ui('nav_guias', 'pt')}</div>
    {guias.map((p) => (
      <a
        class="item"
        href={`${base}/${p.id}`}
        aria-current={eh(`${base}/${p.id}`) ? 'page' : undefined}
        data-rot-pt={p.data.titulo}
        data-rot-en={p.data.titulo_en || p.data.titulo}
      >{p.data.titulo}</a>
    ))}

    <div class="camada" data-rot-pt={ui('nav_camada_mundo', 'pt')} data-rot-en={ui('nav_camada_mundo', 'en')}>{ui('nav_camada_mundo', 'pt')}</div>
    <a
      class="item"
      href={`${base}/nosso-mundo`}
      aria-current={eh(`${base}/nosso-mundo`) ? 'page' : undefined}
      data-rot-pt={ui('mundo_visao', 'pt')}
      data-rot-en={ui('mundo_visao', 'en')}
    >{ui('mundo_visao', 'pt')}</a>
    {naSecao && doNossoMundo.map((p) => (
      <a
        class="item"
        href={`${base}/${p.id}`}
        aria-current={eh(`${base}/${p.id}`) ? 'page' : undefined}
        data-rot-pt={p.data.titulo}
        data-rot-en={p.data.titulo_en || p.data.titulo}
      >{p.data.titulo}</a>
    ))}

    <div class="camada" data-rot-pt={ui('nav_projeto', 'pt')} data-rot-en={ui('nav_projeto', 'en')}>{ui('nav_projeto', 'pt')}</div>
    <a
      class="item"
      href={REPO}
      data-rot-pt={ui('nav_contribuir', 'pt')}
      data-rot-en={ui('nav_contribuir', 'en')}
    >{ui('nav_contribuir', 'pt')}</a>
  </nav>

  <main class="conteudo">
    <div
      class="caixa-busca"
      data-ph-pt={ui('busca_placeholder', 'pt')}
      data-ph-en={ui('busca_placeholder', 'en')}
    >
      <Search id="busca" className="pagefind-ui" uiOptions={{
        showImages: false,
        excerptLength: 22,
        translations: {
          placeholder: ui('busca_placeholder', 'pt'),
          zero_results: `${ui('busca_vazio', 'pt')} [SEARCH_TERM]`,
          many_results: '[COUNT] resultados para [SEARCH_TERM]',
          one_result: '1 resultado para [SEARCH_TERM]',
          searching: 'Buscando...',
          load_more: ui('busca_mais', 'pt'),
          clear_search: ui('busca_limpar', 'pt'),
        },
      }} />
    </div>

    <slot />

    <footer class="rodape-pagina">
      <span>
        {atualizado && (
          <>
            <span data-rot-pt={ui('rodape_revisado', 'pt')} data-rot-en={ui('rodape_revisado', 'en')}>{ui('rodape_revisado', 'pt')}</span>
            {' '}{atualizado.toLocaleDateString('pt-BR')} ·{' '}
          </>
        )}
        <span data-rot-pt={ui('rodape_aberto', 'pt')} data-rot-en={ui('rodape_aberto', 'en')}>{ui('rodape_aberto', 'pt')}</span>
      </span>
      {arquivoFonte && (
        <a
          href={`${REPO}/edit/main/src/content/wiki/${arquivoFonte}`}
          data-rot-pt={ui('rodape_corrigir', 'pt')}
          data-rot-en={ui('rodape_corrigir', 'en')}
        >{ui('rodape_corrigir', 'pt')}</a>
      )}
    </footer>
  </main>
</div>

<Chat />
</body>
</html>
