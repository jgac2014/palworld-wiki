---
import { getCollection } from 'astro:content';
import Search from 'astro-pagefind/components/Search.astro';
import Chat from '../components/Chat.astro';
import FichaPal from '../components/FichaPal.astro';
import SeletorIdioma from '../components/SeletorIdioma.astro';
import SeletorTema from '../components/SeletorTema.astro';
import SeletorProgresso from '../components/SeletorProgresso.astro';
import { ui } from '../lib/termos.js';
import { dataBr } from '../lib/datas.js';
import '../styles/global.css';

interface Props {
  titulo: string;
  descricao?: string;
  atualizado?: Date;
  arquivoFonte?: string;
}

const { titulo, descricao = '', atualizado, arquivoFonte } = Astro.props;

const paginas = (await getCollection('wiki', ({ data }) => !data.rascunho))
  .sort((a, b) => a.data.ordem - b.data.ordem);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const atual = Astro.url.pathname.replace(/\/$/, '');
const eh = (href: string) => atual === href.replace(/\/$/, '');

// Decisão 3.0 do PRD: as duas metades não se misturam na navegação. A wiki é
// pública e vale para qualquer jogador; o nosso mundo só vale para nós quatro.
const guias = paginas.filter((p) => p.data.camada !== 'nosso-mundo');
const doNossoMundo = paginas.filter((p) => p.data.camada === 'nosso-mundo');
// As páginas do nosso mundo só aparecem no menu de dentro da própria seção.
// De fora, quem chegou pelo Google vê a porta, não o conteúdo do nosso save.
const naSecao = eh(`${base}/nosso-mundo`) || eh(`${base}/painel`) || doNossoMundo.some((p) => eh(`${base}/${p.id}`));

const REPO = 'https://github.com/nederreis/PalCrew';
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo} · Wiki Palworld 1.0</title>
  <meta name="description" content={descricao} />
  <meta property="og:title" content={`${titulo} · Wiki Palworld 1.0`} />
  <meta property="og:description" content={descricao} />
  <meta property="og:type" content="article" />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <!--
    O tema é aplicado aqui, no <head>, e não pelo componente do seletor: script
    de componente roda depois da primeira pintura, e quem escolheu claro veria a
    página nascer escura e piscar em toda visita.

    Sem escolha gravada, vale a preferência do sistema. Com escolha gravada, ela
    vence o sistema nos dois sentidos, que é o critério de aceite da D6.
  -->
  <script is:inline>
    (function () {
      var CHAVE = 'palworld-wiki-tema';
      var escolhido = null;
      try { escolhido = localStorage.getItem(CHAVE); } catch (e) {}
      if (escolhido !== 'claro' && escolhido !== 'escuro') {
        escolhido = window.matchMedia('(prefers-color-scheme: light)').matches ? 'claro' : 'escuro';
      }
      document.documentElement.dataset.tema = escolhido;
    })();
  </script>
</head>
<body>
<div class="casca">

  <nav class="lateral">
    <a
      class="marca"
      href={`${base}/`}
      data-rot-pt={ui('marca', 'pt')}
      data-rot-en={ui('marca', 'en')}
    >{ui('marca', 'pt')}</a>
    <SeletorIdioma />
    <SeletorTema />
    <div class="marca-sub">
      <span data-rot-pt={ui('marca_sub', 'pt')} data-rot-en={ui('marca_sub', 'en')}>{ui('marca_sub', 'pt')}</span><br />
      <span data-rot-pt={ui('marca_versao', 'pt')} data-rot-en={ui('marca_versao', 'en')}>{ui('marca_versao', 'pt')}</span> 1.0.2.101103
    </div>

    {/*
      As duas camadas são pares, e o menu tinha deixado de mostrar isso: a
      Camada 2 vinha depois dos 12 guias, o que a jogava abaixo da dobra numa
      tela de 1080. Ela sobe para o topo INTEIRA, com o título de camada junto.

      Mover só o link, deixando o título embaixo, poria um link do nosso save
      dentro do bloco da wiki, que é exatamente a mistura que a decisão 3.0 do
      PRD proíbe. E deixar o título "A wiki" acima de um bloco que não é dela
      faria os 17 links da wiki serem lidos como parte do nosso mundo.
    */}
    <div class="camada" data-rot-pt={ui('nav_camada_mundo', 'pt')} data-rot-en={ui('nav_camada_mundo', 'en')}>{ui('nav_camada_mundo', 'pt')}</div>
    <SeletorProgresso />
    <a
      class="item"
      href={`${base}/nosso-mundo`}
      aria-current={eh(`${base}/nosso-mundo`) ? 'page' : undefined}
      data-rot-pt={ui('mundo_visao', 'pt')}
      data-rot-en={ui('mundo_visao', 'en')}
    >{ui('mundo_visao', 'pt')}</a>
    {naSecao && (
      <a
        class="item"
        href={`${base}/painel`}
        aria-current={eh(`${base}/painel`) ? 'page' : undefined}
        data-rot-pt={ui('painel_titulo', 'pt')}
        data-rot-en={ui('painel_titulo', 'en')}
      >{ui('painel_titulo', 'pt')}</a>
    )}
    {naSecao && doNossoMundo.map((p) => (
      <a
        class="item"
        href={`${base}/${p.id}`}
        aria-current={eh(`${base}/${p.id}`) ? 'page' : undefined}
        data-rot-pt={p.data.titulo}
        data-rot-en={p.data.titulo_en || p.data.titulo}
      >{p.data.titulo}</a>
    ))}

    <div class="camada" data-rot-pt={ui('nav_camada_wiki', 'pt')} data-rot-en={ui('nav_camada_wiki', 'en')}>{ui('nav_camada_wiki', 'pt')}</div>

    <div class="grupo" data-rot-pt={ui('nav_catalogo', 'pt')} data-rot-en={ui('nav_catalogo', 'en')}>{ui('nav_catalogo', 'pt')}</div>
    {[
      ['pals', 'nav_pals'],
      ['itens', 'nav_itens'],
      ['estruturas', 'nav_estruturas'],
      ['tecnologias', 'nav_tecnologias'],
    ].map(([rota, chave]) => (
      <a
        class="item"
        href={`${base}/${rota}`}
        aria-current={eh(`${base}/${rota}`) ? 'page' : undefined}
        data-rot-pt={ui(chave, 'pt')}
        data-rot-en={ui(chave, 'en')}
      >{ui(chave, 'pt')}</a>
    ))}

    <div class="grupo" data-rot-pt={ui('nav_ferramentas', 'pt')} data-rot-en={ui('nav_ferramentas', 'en')}>{ui('nav_ferramentas', 'pt')}</div>
    <a
      class="item"
      href={`${base}/mapa`}
      aria-current={eh(`${base}/mapa`) ? 'page' : undefined}
      data-rot-pt={ui('nav_mapa', 'pt')}
      data-rot-en={ui('nav_mapa', 'en')}
    >{ui('nav_mapa', 'pt')}</a>

    <div class="grupo" data-rot-pt={ui('nav_guias', 'pt')} data-rot-en={ui('nav_guias', 'en')}>{ui('nav_guias', 'pt')}</div>
    {guias.map((p) => (
      <a
        class="item"
        href={`${base}/${p.id}`}
        aria-current={eh(`${base}/${p.id}`) ? 'page' : undefined}
        data-rot-pt={p.data.titulo}
        data-rot-en={p.data.titulo_en || p.data.titulo}
      >{p.data.titulo}</a>
    ))}

    <div class="camada" data-rot-pt={ui('nav_projeto', 'pt')} data-rot-en={ui('nav_projeto', 'en')}>{ui('nav_projeto', 'pt')}</div>
    <a
      class="item"
      href={REPO}
      data-rot-pt={ui('nav_contribuir', 'pt')}
      data-rot-en={ui('nav_contribuir', 'en')}
    >{ui('nav_contribuir', 'pt')}</a>
  </nav>

  <main class="conteudo">
    <div
      class="caixa-busca"
      data-ph-pt={ui('busca_placeholder', 'pt')}
      data-ph-en={ui('busca_placeholder', 'en')}
    >
      <Search className="pagefind-ui" />
    </div>

    <script>
      /**
       * A busca também alterna de idioma (R2.4).
       *
       * O que estava aqui antes era um objeto `uiOptions` com as traduções
       * escritas à mão. Ele nunca chegou à busca: a versão instalada do
       * astro-pagefind é a de web components, cujas props são outras, e prop
       * desconhecida em componente Astro é ignorada em silêncio. Por isso a
       * mensagem de vazio nascia em português e ficava, mesmo com o site em
       * inglês, e ninguém tinha errado ao escrever a tradução.
       *
       * O componente traz o conjunto completo nos dois idiomas, incluindo o
       * termo buscado dentro da mensagem de vazio, plural e o texto que vai
       * para o leitor de tela. Trocar o idioma da instância aproveita tudo
       * isso e é uma chamada, contra reconstruir a busca inteira.
       *
       * O texto já digitado sobrevive porque quem redesenha é o próprio
       * componente, que guarda e devolve o valor do campo. Reconstruir a
       * instância, que era o caminho previsto na tarefa, perderia a busca em
       * andamento.
       */
      const CODIGO = { pt: 'pt-BR', en: 'en' };

      function trocarIdiomaDaBusca(idioma) {
        const instancias = new Set();
        document.querySelectorAll('pagefind-searchbox, pagefind-modal').forEach((el) => {
          if (el.instance) instancias.add(el.instance);
        });
        instancias.forEach((i) => i.setLanguage(CODIGO[idioma] || CODIGO.pt));
      }

      const atual = () => (document.documentElement.dataset.idioma === 'en' ? 'en' : 'pt');

      // Na carga a ordem não é garantida: o seletor pode aplicar o idioma antes
      // de o componente existir, e aí a busca nasceria em português com o site
      // em inglês. whenDefined resolve depois do connectedCallback, quando a
      // instância já está pendurada no elemento.
      customElements.whenDefined('pagefind-searchbox').then(() => trocarIdiomaDaBusca(atual()));
      document.addEventListener('idioma:mudou', (e) => trocarIdiomaDaBusca(e.detail.idioma));
    </script>

    <slot />

    <footer class="rodape-pagina">
      <span>
        {atualizado && (
          <>
            <span data-rot-pt={ui('rodape_revisado', 'pt')} data-rot-en={ui('rodape_revisado', 'en')}>{ui('rodape_revisado', 'pt')}</span>
            {' '}{dataBr(atualizado)} ·{' '}
          </>
        )}
        <span data-rot-pt={ui('rodape_aberto', 'pt')} data-rot-en={ui('rodape_aberto', 'en')}>{ui('rodape_aberto', 'pt')}</span>
      </span>
      {arquivoFonte && (
        <a
          href={`${REPO}/edit/main/src/content/wiki/${arquivoFonte}`}
          data-rot-pt={ui('rodape_corrigir', 'pt')}
          data-rot-en={ui('rodape_corrigir', 'en')}
        >{ui('rodape_corrigir', 'pt')}</a>
      )}
    </footer>
  </main>
</div>

<Chat />
<FichaPal />
</body>
</html>
