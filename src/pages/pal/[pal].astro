---
/**
 * Uma página por Pal do catálogo, 299 no total.
 *
 * O dado vem inteiro de catalogo.json, que é importado do paldb e nunca
 * digitado. Quando existe entrada em pals.json, a curadoria entra em destaque
 * ACIMA da ficha: opinião nossa vale mais que tabela, e é o que nenhuma wiki
 * grande consegue copiar. Sem curadoria a página continua útil e diz, com
 * todas as letras, que ainda não temos análise.
 */
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import catalogo from '../../data/catalogo.json';
import curadoria from '../../data/pals.json';
import fichasPal from '../../data/fichas-pal.json';
import referenciaFichas from '../../data/referencia-fichas-pal.json';
import itensJson from '../../data/itens.json';
import mapaPontos from '../../data/mapa-pontos.json';
import { termo, ui, rotuloApt } from '../../lib/termos.js';
import { quemTem } from '../../lib/progresso.js';
import { enderecoPal, enderecoItem } from '../../lib/enderecos.js';
import GithubSlugger from 'github-slugger';

const REPO = 'https://github.com/nederreis/PalCrew';

export async function getStaticPaths() {
  const paginas = await getCollection('wiki', ({ data }) => !data.rascunho);

  // Que guias citam cada Pal.
  //
  // Uma alternância única, ordenada do nome mais longo para o mais curto, para
  // "Reptyro" não casar dentro de "Reptyro Cryst": o regex escolhe o mais longo
  // que começa na mesma posição. E lookaround Unicode em vez de \b, que é ASCII
  // e não casa antes de letra acentuada.
  const nomes = [...new Set(catalogo.pals.flatMap((p) => [p.en, p.pt]))]
    .sort((a, b) => b.length - a.length)
    .map((n) => n.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
  const varredura = new RegExp(
    `(?<![\\p{L}\\p{N}_])(${nomes.join('|')})(?![\\p{L}\\p{N}_])`,
    'gu',
  );

  // Onde DENTRO do guia, e não só em qual guia.
  //
  // Antes a lista ligava para `/breeding/` e parava aí. O guia mais longo tem
  // 34.314 caracteres e a média é 8.615: o link caía no topo e quem clicou
  // procurava o nome à mão. Pior, Anubis aparecia em 10 dos 15 guias, e uma
  // lista com dois terços dos guias não responde "onde", responde "em quase
  // todo lugar".
  //
  // A âncora sai do MESMO slugger que o Astro usa para gerar o id do título,
  // github-slugger, e não de uma regra reescrita aqui: duas implementações da
  // mesma coisa divergem no primeiro título com acento ou com ponto. O
  // slugger é reiniciado por página porque ele numera repetição, e o segundo
  // "Combate" de um documento vira "combate-1".
  //
  // Citação antes do primeiro subtítulo aponta para #topo, que existe no
  // layout do guia. São 29 das 415, e sem âncora de verdade elas voltariam a
  // ser link para o topo.
  const citacoes = new Map();
  for (const pagina of paginas) {
    const slugger = new GithubSlugger();
    let secao = { texto: null, ancora: 'topo' };
    for (const linha of pagina.body.split('\n')) {
      const titulo = linha.match(/^#{2,6}\s+(.+?)\s*$/);
      if (titulo) {
        const texto = titulo[1].replace(/[*_`]/g, '').trim();
        secao = { texto, ancora: slugger.slug(texto) };
        continue;
      }
      for (const achado of linha.matchAll(varredura)) {
        const nome = achado[1];
        if (!citacoes.has(nome)) citacoes.set(nome, new Map());
        const porPagina = citacoes.get(nome);
        if (!porPagina.has(pagina.id)) {
          porPagina.set(pagina.id, { ...pagina.data, secoes: new Map() });
        }
        porPagina.get(pagina.id).secoes.set(secao.ancora, secao);
      }
    }
  }

  const porNome = new Map(curadoria.pals.map((p) => [p.nome, p]));

  // ---------------------------------------------- a ficha importada (E10)
  const itemPorChave = new Map(itensJson.itens.map((i) => [i.chave, i]));
  const itensPorNomeEn = new Map(itensJson.itens.map((i) => [i.en, i]));
  // Nome do item vindo de itens.json, nunca o `nome` cru da importação, que é o
  // inglês da ficha do paldb. É o defeito que a F12 corrigiu em /tecnologias.
  const comNomeDeItem = (d) => {
    const i = itemPorChave.get(d.chave);
    return { ...d, endereco: enderecoItem(d.chave), pt: i?.pt ?? d.chave, en: i?.en ?? d.nome ?? d.chave };
  };

  // Pal que existe como marcador NOMEADO no mapa ganha link para o ponto.
  //
  // São 137 dos 299, e os três tipos que carregam nome de Pal e coordenada são
  // "Alpha Pal", "Unknown" e "City". Os outros 162 não têm ponto porque o paldb
  // não publica coordenada de spawn comum, só área nomeada: a ficha diz isso em
  // vez de deixar a seção parecendo incompleta.
  const nomesNoMapa = new Set(
    mapaPontos.pontos.filter((p) => p.en && typeof p.lv === 'number').map((p) => p.en),
  );

  const divergentes = new Map();
  for (const d of referenciaFichas.divergencias_abertas ?? []) {
    divergentes.set(`${d.pal}|${d.lista}|${d.item}`, d);
  }

  // Âncora da seção de divergência no fontes.md, tirada do MESMO slugger que o
  // Astro usa, e não escrita à mão.
  //
  // Escrever à mão já falhou aqui: o título tem "contradição" e o literal foi
  // digitado "contradicao", que é âncora quebrada. É o defeito exato da F11, e
  // a regra que ela deixou é esta: duas implementações da mesma coisa divergem
  // no primeiro título com acento. O slugger roda sobre TODOS os títulos da
  // página, em ordem, porque ele numera repetição.
  //
  // Não achar a seção FALHA o build em vez de gerar link para lugar nenhum: a
  // ficha afirma que há divergência registrada, e afirmação com link morto é
  // pior que afirmação sem link.
  const fontes = paginas.find((p) => p.id === 'fontes');
  if (!fontes) throw new Error('E10: fontes.md não está na coleção, e a ficha de Pal liga para a seção de divergência dele');
  const sluggerFontes = new GithubSlugger();
  let ancoraDivergencia = null;
  for (const linha of fontes.body.split('\n')) {
    const t = linha.match(/^#{2,6}\s+(.+?)\s*$/);
    if (!t) continue;
    const texto = t[1].replace(/[*_`]/g, '').trim();
    const slug = sluggerFontes.slug(texto);
    if (/drops/i.test(texto) && /wiki\.gg/i.test(texto)) ancoraDivergencia = slug;
  }
  if (divergentes.size && !ancoraDivergencia) {
    throw new Error('E10: há divergência registrada e o fontes.md não tem a seção que a explica');
  }

  return catalogo.pals.map((pal) => {
    // O nome em inglês e o em português podem cair em seções diferentes do
    // mesmo guia, então as duas listas são somadas por seção e não
    // sobrescritas uma pela outra.
    const guias = new Map();
    for (const fonte of [citacoes.get(pal.en), citacoes.get(pal.pt)]) {
      for (const [id, data] of fonte || []) {
        if (!guias.has(id)) guias.set(id, { ...data, secoes: new Map() });
        for (const [ancora, secao] of data.secoes) guias.get(id).secoes.set(ancora, secao);
      }
    }
    const f = fichasPal.fichas[pal.chave] ?? null;
    const marcar = (lista, nome) =>
      (lista ?? []).map((d) => ({
        ...comNomeDeItem(d),
        divergencia: divergentes.get(`${pal.chave}|${nome}|${d.chave}`) ?? null,
      }));

    return {
      params: { pal: enderecoPal(pal.chave) },
      props: {
        pal,
        nossa: porNome.get(pal.en) || null,
        guias: [...guias.entries()].map(([id, data]) => ({
          id,
          ...data,
          secoes: [...data.secoes.values()],
        })),
        atributos: f?.atributos ?? null,
        // O valor de `egg` e nome de ITEM, e sai em portugues com link, como
        // qualquer outro. Publicado cru ele poe "Verdant Egg" no meio de uma
        // pagina em portugues, que e o defeito que a F12 corrigiu na coluna
        // TIPO de /tecnologias. Os 26 valores distintos existem em itens.json.
        ovo: (() => {
          const i = itensPorNomeEn.get(f?.atributos?.egg);
          return i ? { pt: i.pt, en: i.en, endereco: enderecoItem(i.chave) } : null;
        })(),
        drops: marcar(f?.drops, 'drops'),
        // O alfa vai SEM quantidade, decidido em 05.08: as duas fontes
        // concordam sobre o item e discordam sobre quanto. Ver fontes.md.
        dropsAlfa: marcar(f?.drops_alfa, 'drops_alfa').map(({ min, max, ...resto }) => resto),
        dropsPorNivel: [...marcar(f?.drops_por_nivel, 'drops_por_nivel'), ...marcar(f?.drops_alfa_por_nivel, 'drops_alfa_por_nivel')]
          .sort((a, b) => a.nivel - b.nivel || a.pt.localeCompare(b.pt, 'pt-BR')),
        captura: f?.captura ?? null,
        noMapa: nomesNoMapa.has(pal.en),
        ancoraDivergencia,
      },
    };
  });
}

const { pal, nossa, guias, atributos, ovo, drops, dropsAlfa, dropsPorNivel, captura, noMapa, ancoraDivergencia } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// `code` é o identificador interno do jogo e não é informação para quem joga.
// Fica fora da tela e tem rótulo em interface.json, porque o verificador cobra
// rótulo para todo campo importado e "esqueci" e "tirei de propósito" não podem
// ter a mesma cara.
const ATRIBUTOS_FORA_DA_TELA = new Set(['code', 'egg']);
const atributosNaTela = Object.entries(atributos ?? {}).filter(([k]) => !ATRIBUTOS_FORA_DA_TELA.has(k));
const linkFontes = `${base}/fontes/${ancoraDivergencia ? `#${ancoraDivergencia}` : ''}`;

// Ordenado do maior para o menor: quem lê quer saber para que o Pal serve, e
// isso é a aptidão mais alta, não a ordem alfabética da chave.
const aptidoes = Object.entries(pal.apt || {}).sort((a, b) => b[1] - a[1]);
// Os onze Pals de colaboração não têm número de Palpédia, e imprimir "#null"
// é pior que não imprimir nada. São também os únicos com nome diferente nos
// dois idiomas, então é neles que a linha dos dois nomes aparece.
// Overlay do progresso. Só entra no HTML de quem realmente aparece num save
// lido: as outras 288 fichas não carregam nada nosso, nem escondido.
const posse = quemTem(pal.en);
const dosDoisIdiomas = pal.pt !== pal.en;
const carimbo = (l) => [
  pal.numero ? `${termo('paldeck', l)} #${pal.numero}` : null,
  dosDoisIdiomas ? `PT ${pal.pt} · EN ${pal.en}` : null,
].filter(Boolean).join(' · ');
---
<Base
  titulo={pal.pt}
  descricao={pal.numero
    ? `${pal.pt} em Palworld 1.0: número ${pal.numero} na Palpédia, elementos e aptidões para trabalho com os nomes oficiais em português.`
    : `${pal.pt} em Palworld 1.0: entidade da colaboração com Terraria, sem número de Palpédia, com elementos e aptidões para trabalho em português.`}
  usaProgresso
>
  <article data-pagefind-body>
    <h1 data-rot-pt={pal.pt} data-rot-en={pal.en}>{pal.pt}</h1>
    {carimbo('pt') && <div class="carimbo" data-rot-pt={carimbo('pt')} data-rot-en={carimbo('en')}>{carimbo('pt')}</div>}

    {posse.length > 0 ? (
      <p class="posse">
        {posse.map((p) => (
          <span class="marca-posse so-com-progresso" data-lido-em={p.lido_em}>
            <span aria-hidden="true">✓</span>{' '}
            <span data-rot-pt={ui(p.onde === 'squad' ? 'posse_squad' : 'posse_palbox', 'pt')} data-rot-en={ui(p.onde === 'squad' ? 'posse_squad' : 'posse_palbox', 'en')}>{ui(p.onde === 'squad' ? 'posse_squad' : 'posse_palbox', 'pt')}</span>
            {' '}{p.pessoa}{p.nivel ? <>, <span data-rot-pt={ui('posse_nivel', 'pt')} data-rot-en={ui('posse_nivel', 'en')}>{ui('posse_nivel', 'pt')}</span> {p.nivel}</> : null}
          </span>
        ))}
        <span class="marca-posse vencida so-vencido" data-lido-em={posse[0].lido_em}>
          <span data-rot-pt={ui('posse_vencido', 'pt')} data-rot-en={ui('posse_vencido', 'en')}>{ui('posse_vencido', 'pt')}</span>
        </span>
      </p>
    ) : (
      <p class="posse so-sem-registro" data-rot-pt={ui('posse_sem_registro', 'pt')} data-rot-en={ui('posse_sem_registro', 'en')}>{ui('posse_sem_registro', 'pt')}</p>
    )}

    {pal.elementos?.length > 0 && (
      <p class="elementos">
        {pal.elementos.map((e) => (
          <span class="elemento" data-rot-pt={e.pt} data-rot-en={e.en}>{e.pt}</span>
        ))}
      </p>
    )}

    {nossa && (
      <aside class="adm adm-destaque" data-rotulo={ui('pal_nossa_analise', 'pt')}>
        {nossa.efeito && <p><strong>{nossa.efeito}</strong></p>}
        {nossa.onde && <p>{nossa.onde}</p>}
        {nossa.nota && <p>{nossa.nota}</p>}
        {nossa.aura && (
          <p>
            <span data-rot-pt={ui('pals_aura', 'pt')} data-rot-en={ui('pals_aura', 'en')}>{ui('pals_aura', 'pt')}</span>{' '}
            <span data-rot-pt={rotuloApt(nossa.aura).pt} data-rot-en={rotuloApt(nossa.aura).en}>{rotuloApt(nossa.aura).pt}</span>
          </p>
        )}
      </aside>
    )}

    <h2 data-rot-pt={termo('apt', 'pt')} data-rot-en={termo('apt', 'en')}>{termo('apt', 'pt')}</h2>
    {aptidoes.length === 0 ? (
      <p data-rot-pt={ui('pal_sem_apt', 'pt')} data-rot-en={ui('pal_sem_apt', 'en')}>{ui('pal_sem_apt', 'pt')}</p>
    ) : (
      <div class="aptidoes">
        {aptidoes.map(([chave, nivel]) => (
          <div class="apt-linha">
            <span class="nome" data-rot-pt={rotuloApt(chave).pt} data-rot-en={rotuloApt(chave).en}>{rotuloApt(chave).pt}</span>
            <span class="apt-barra" role="img" aria-label={`${rotuloApt(chave).pt} ${nivel} de 10`}>
              <i data-nivel={nivel} style={`width:${nivel * 10}%`}></i>
            </span>
            <span class="v">{nivel}</span>
          </div>
        ))}
      </div>
    )}

    {!nossa && (
      <p class="sem-curadoria">
        <span data-rot-pt={ui('pal_sem_curadoria', 'pt')} data-rot-en={ui('pal_sem_curadoria', 'en')}>{ui('pal_sem_curadoria', 'pt')}</span>{' '}
        <a
          href={`${REPO}/blob/main/CONTRIBUINDO.md`}
          data-rot-pt={ui('pal_contribuir', 'pt')}
          data-rot-en={ui('pal_contribuir', 'en')}
        >{ui('pal_contribuir', 'pt')}</a>
      </p>
    )}

    {atributosNaTela.length > 0 && (
      <>
        <h2 data-rot-pt={ui('pal_atributos', 'pt')} data-rot-en={ui('pal_atributos', 'en')}>{ui('pal_atributos', 'pt')}</h2>
        <p class="sub-bloco" data-rot-pt={ui('pal_atributos_sub', 'pt')} data-rot-en={ui('pal_atributos_sub', 'en')}>{ui('pal_atributos_sub', 'pt')}</p>
        <ul class="atributos">
          {ovo && (
            <li>
              <span class="rot" data-rot-pt={ui('atr_egg', 'pt')} data-rot-en={ui('atr_egg', 'en')}>{ui('atr_egg', 'pt')}</span>
              <a class="val" href={`${base}/item/${ovo.endereco}/`} data-rot-pt={ovo.pt} data-rot-en={ovo.en}>{ovo.pt}</a>
            </li>
          )}
          {atributosNaTela.map(([chave, valor]) => (
            <li>
              <span class="rot" data-rot-pt={ui(`atr_${chave}`, 'pt')} data-rot-en={ui(`atr_${chave}`, 'en')}>{ui(`atr_${chave}`, 'pt')}</span>
              <span class="val">{valor}</span>
            </li>
          ))}
        </ul>
      </>
    )}

    <h2 data-rot-pt={ui('pal_drops', 'pt')} data-rot-en={ui('pal_drops', 'en')}>{ui('pal_drops', 'pt')}</h2>
    {drops.length === 0 && dropsAlfa.length === 0 && dropsPorNivel.length === 0 ? (
      <p class="sub-bloco" data-rot-pt={ui('pal_sem_drops', 'pt')} data-rot-en={ui('pal_sem_drops', 'en')}>{ui('pal_sem_drops', 'pt')}</p>
    ) : (
      <>
        {drops.length > 0 && (
          <ul class="drops">
            {drops.map((d) => (
              <li>
                <a href={`${base}/item/${d.endereco}/`} data-rot-pt={d.pt} data-rot-en={d.en}>{d.pt}</a>
                <span class="qtd">{d.min === d.max ? d.min : `${d.min}-${d.max}`}</span>
                <span class="prob">{d.probabilidade}%</span>
                {/*
                  Divergência aberta fica À VISTA na linha, e o valor publicado
                  é o do paldb, que é a fonte de registro desta importação.
                  Nunca média e nunca escolha silenciosa: a regra é a mesma que
                  o fontes.md aplica desde a R1.2.
                */}
                {d.divergencia && (
                  <a class="divergencia" href={linkFontes}>
                    <span data-rot-pt={ui('pal_divergencia', 'pt')} data-rot-en={ui('pal_divergencia', 'en')}>{ui('pal_divergencia', 'pt')}</span>{': '}{d.divergencia.wiki_gg}{'. '}
                    <span data-rot-pt={ui('pal_ver_fontes', 'pt')} data-rot-en={ui('pal_ver_fontes', 'en')}>{ui('pal_ver_fontes', 'pt')}</span>
                  </a>
                )}
              </li>
            ))}
          </ul>
        )}

        {dropsAlfa.length > 0 && (
          <>
            <h3 data-rot-pt={ui('pal_drops_alfa', 'pt')} data-rot-en={ui('pal_drops_alfa', 'en')}>{ui('pal_drops_alfa', 'pt')}</h3>
            <ul class="drops sem-quantidade">
              {dropsAlfa.map((d) => (
                <li><a href={`${base}/item/${d.endereco}/`} data-rot-pt={d.pt} data-rot-en={d.en}>{d.pt}</a></li>
              ))}
            </ul>
            <p class="sub-bloco aviso">
              <span data-rot-pt={ui('pal_drops_alfa_sem_qtd', 'pt')} data-rot-en={ui('pal_drops_alfa_sem_qtd', 'en')}>{ui('pal_drops_alfa_sem_qtd', 'pt')}</span>{' '}
              <a href={linkFontes} data-rot-pt={ui('pal_ver_fontes', 'pt')} data-rot-en={ui('pal_ver_fontes', 'en')}>{ui('pal_ver_fontes', 'pt')}</a>
            </p>
          </>
        )}

        {dropsPorNivel.length > 0 && (
          <>
            <h3 data-rot-pt={ui('pal_drops_nivel', 'pt')} data-rot-en={ui('pal_drops_nivel', 'en')}>{ui('pal_drops_nivel', 'pt')}</h3>
            <p class="sub-bloco" data-rot-pt={ui('pal_drops_nivel_sub', 'pt')} data-rot-en={ui('pal_drops_nivel_sub', 'en')}>{ui('pal_drops_nivel_sub', 'pt')}</p>
            <ul class="drops por-nivel">
              {dropsPorNivel.map((d) => (
                <li>
                  <a href={`${base}/item/${d.endereco}/`} data-rot-pt={d.pt} data-rot-en={d.en}>{d.pt}</a>
                  <span class="qtd">{d.min === d.max ? d.min : `${d.min}-${d.max}`}</span>
                  <span class="prob">{d.probabilidade}%</span>
                  <span class="nivel">
                    <span data-rot-pt={ui('pal_drops_nivel_a_partir', 'pt')} data-rot-en={ui('pal_drops_nivel_a_partir', 'en')}>{ui('pal_drops_nivel_a_partir', 'pt')}</span>{' '}{d.nivel}
                  </span>
                </li>
              ))}
            </ul>
          </>
        )}
      </>
    )}

    <h2 data-rot-pt={ui('pal_captura', 'pt')} data-rot-en={ui('pal_captura', 'en')}>{ui('pal_captura', 'pt')}</h2>
    {!captura ? (
      <p class="sub-bloco" data-rot-pt={ui('pal_sem_captura', 'pt')} data-rot-en={ui('pal_sem_captura', 'en')}>{ui('pal_sem_captura', 'pt')}</p>
    ) : (
      <>
        {noMapa && (
          <p class="no-mapa">
            <a href={`${base}/mapa/?busca=${encodeURIComponent(pal.en)}`} data-rot-pt={ui('pal_captura_no_mapa', 'pt')} data-rot-en={ui('pal_captura_no_mapa', 'en')}>{ui('pal_captura_no_mapa', 'pt')}</a>
          </p>
        )}
        <p class="sub-bloco" data-rot-pt={ui('pal_captura_areas', 'pt')} data-rot-en={ui('pal_captura_areas', 'en')}>{ui('pal_captura_areas', 'pt')}</p>
        <ul class="areas">
          {captura.map((c) => (
            <li>
              <code>{c.area}</code>
              {c.nivel_min != null && (
                <span class="nivel">
                  <span data-rot-pt={ui('pal_nivel', 'pt')} data-rot-en={ui('pal_nivel', 'en')}>{ui('pal_nivel', 'pt')}</span>{' '}
                  {c.nivel_min === c.nivel_max ? c.nivel_min : `${c.nivel_min}-${c.nivel_max}`}
                </span>
              )}
            </li>
          ))}
        </ul>
        {!noMapa && (
          <p class="sub-bloco aviso" data-rot-pt={ui('pal_captura_sem_coord', 'pt')} data-rot-en={ui('pal_captura_sem_coord', 'en')}>{ui('pal_captura_sem_coord', 'pt')}</p>
        )}
      </>
    )}

    <h2 data-rot-pt={ui('pal_nos_guias', 'pt')} data-rot-en={ui('pal_nos_guias', 'en')}>{ui('pal_nos_guias', 'pt')}</h2>
    {guias.length === 0 ? (
      <p data-rot-pt={ui('pal_sem_guias', 'pt')} data-rot-en={ui('pal_sem_guias', 'en')}>{ui('pal_sem_guias', 'pt')}</p>
    ) : (
      <ul class="guias">
        {guias.map((g) => (
          <li>
            <span class="guia" data-rot-pt={g.titulo} data-rot-en={g.titulo_en || g.titulo}>{g.titulo}</span>
            <span class="secoes">
              {g.secoes.map((s) => (
                <a href={`${base}/${g.id}/#${s.ancora}`}>{s.texto || ui('pal_guia_topo', 'pt')}</a>
              ))}
            </span>
          </li>
        ))}
      </ul>
    )}
  </article>
</Base>

