---
/**
 * Uma página por Pal do catálogo, 299 no total.
 *
 * O dado vem inteiro de catalogo.json, que é importado do paldb e nunca
 * digitado. Quando existe entrada em pals.json, a curadoria entra em destaque
 * ACIMA da ficha: opinião nossa vale mais que tabela, e é o que nenhuma wiki
 * grande consegue copiar. Sem curadoria a página continua útil e diz, com
 * todas as letras, que ainda não temos análise.
 */
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import catalogo from '../../data/catalogo.json';
import curadoria from '../../data/pals.json';
import { termo, ui, rotuloApt } from '../../lib/termos.js';
import { quemTem } from '../../lib/progresso.js';
import { enderecoPal } from '../../lib/enderecos.js';
import GithubSlugger from 'github-slugger';

const REPO = 'https://github.com/nederreis/PalCrew';

export async function getStaticPaths() {
  const paginas = await getCollection('wiki', ({ data }) => !data.rascunho);

  // Que guias citam cada Pal.
  //
  // Uma alternância única, ordenada do nome mais longo para o mais curto, para
  // "Reptyro" não casar dentro de "Reptyro Cryst": o regex escolhe o mais longo
  // que começa na mesma posição. E lookaround Unicode em vez de \b, que é ASCII
  // e não casa antes de letra acentuada.
  const nomes = [...new Set(catalogo.pals.flatMap((p) => [p.en, p.pt]))]
    .sort((a, b) => b.length - a.length)
    .map((n) => n.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
  const varredura = new RegExp(
    `(?<![\\p{L}\\p{N}_])(${nomes.join('|')})(?![\\p{L}\\p{N}_])`,
    'gu',
  );

  // Onde DENTRO do guia, e não só em qual guia.
  //
  // Antes a lista ligava para `/breeding/` e parava aí. O guia mais longo tem
  // 34.314 caracteres e a média é 8.615: o link caía no topo e quem clicou
  // procurava o nome à mão. Pior, Anubis aparecia em 10 dos 15 guias, e uma
  // lista com dois terços dos guias não responde "onde", responde "em quase
  // todo lugar".
  //
  // A âncora sai do MESMO slugger que o Astro usa para gerar o id do título,
  // github-slugger, e não de uma regra reescrita aqui: duas implementações da
  // mesma coisa divergem no primeiro título com acento ou com ponto. O
  // slugger é reiniciado por página porque ele numera repetição, e o segundo
  // "Combate" de um documento vira "combate-1".
  //
  // Citação antes do primeiro subtítulo aponta para #topo, que existe no
  // layout do guia. São 29 das 415, e sem âncora de verdade elas voltariam a
  // ser link para o topo.
  const citacoes = new Map();
  for (const pagina of paginas) {
    const slugger = new GithubSlugger();
    let secao = { texto: null, ancora: 'topo' };
    for (const linha of pagina.body.split('\n')) {
      const titulo = linha.match(/^#{2,6}\s+(.+?)\s*$/);
      if (titulo) {
        const texto = titulo[1].replace(/[*_`]/g, '').trim();
        secao = { texto, ancora: slugger.slug(texto) };
        continue;
      }
      for (const achado of linha.matchAll(varredura)) {
        const nome = achado[1];
        if (!citacoes.has(nome)) citacoes.set(nome, new Map());
        const porPagina = citacoes.get(nome);
        if (!porPagina.has(pagina.id)) {
          porPagina.set(pagina.id, { ...pagina.data, secoes: new Map() });
        }
        porPagina.get(pagina.id).secoes.set(secao.ancora, secao);
      }
    }
  }

  const porNome = new Map(curadoria.pals.map((p) => [p.nome, p]));

  return catalogo.pals.map((pal) => {
    // O nome em inglês e o em português podem cair em seções diferentes do
    // mesmo guia, então as duas listas são somadas por seção e não
    // sobrescritas uma pela outra.
    const guias = new Map();
    for (const fonte of [citacoes.get(pal.en), citacoes.get(pal.pt)]) {
      for (const [id, data] of fonte || []) {
        if (!guias.has(id)) guias.set(id, { ...data, secoes: new Map() });
        for (const [ancora, secao] of data.secoes) guias.get(id).secoes.set(ancora, secao);
      }
    }
    return {
      params: { pal: enderecoPal(pal.chave) },
      props: {
        pal,
        nossa: porNome.get(pal.en) || null,
        guias: [...guias.entries()].map(([id, data]) => ({
          id,
          ...data,
          secoes: [...data.secoes.values()],
        })),
      },
    };
  });
}

const { pal, nossa, guias } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Ordenado do maior para o menor: quem lê quer saber para que o Pal serve, e
// isso é a aptidão mais alta, não a ordem alfabética da chave.
const aptidoes = Object.entries(pal.apt || {}).sort((a, b) => b[1] - a[1]);
// Os onze Pals de colaboração não têm número de Palpédia, e imprimir "#null"
// é pior que não imprimir nada. São também os únicos com nome diferente nos
// dois idiomas, então é neles que a linha dos dois nomes aparece.
// Overlay do progresso. Só entra no HTML de quem realmente aparece num save
// lido: as outras 288 fichas não carregam nada nosso, nem escondido.
const posse = quemTem(pal.en);
const dosDoisIdiomas = pal.pt !== pal.en;
const carimbo = (l) => [
  pal.numero ? `${termo('paldeck', l)} #${pal.numero}` : null,
  dosDoisIdiomas ? `PT ${pal.pt} · EN ${pal.en}` : null,
].filter(Boolean).join(' · ');
---
<Base
  titulo={pal.pt}
  descricao={pal.numero
    ? `${pal.pt} em Palworld 1.0: número ${pal.numero} na Palpédia, elementos e aptidões para trabalho com os nomes oficiais em português.`
    : `${pal.pt} em Palworld 1.0: entidade da colaboração com Terraria, sem número de Palpédia, com elementos e aptidões para trabalho em português.`}
  usaProgresso
>
  <article data-pagefind-body>
    <h1 data-rot-pt={pal.pt} data-rot-en={pal.en}>{pal.pt}</h1>
    {carimbo('pt') && <div class="carimbo" data-rot-pt={carimbo('pt')} data-rot-en={carimbo('en')}>{carimbo('pt')}</div>}

    {posse.length > 0 ? (
      <p class="posse">
        {posse.map((p) => (
          <span class="marca-posse so-com-progresso" data-lido-em={p.lido_em}>
            <span aria-hidden="true">✓</span>{' '}
            <span data-rot-pt={ui(p.onde === 'squad' ? 'posse_squad' : 'posse_palbox', 'pt')} data-rot-en={ui(p.onde === 'squad' ? 'posse_squad' : 'posse_palbox', 'en')}>{ui(p.onde === 'squad' ? 'posse_squad' : 'posse_palbox', 'pt')}</span>
            {' '}{p.pessoa}{p.nivel ? <>, <span data-rot-pt={ui('posse_nivel', 'pt')} data-rot-en={ui('posse_nivel', 'en')}>{ui('posse_nivel', 'pt')}</span> {p.nivel}</> : null}
          </span>
        ))}
        <span class="marca-posse vencida so-vencido" data-lido-em={posse[0].lido_em}>
          <span data-rot-pt={ui('posse_vencido', 'pt')} data-rot-en={ui('posse_vencido', 'en')}>{ui('posse_vencido', 'pt')}</span>
        </span>
      </p>
    ) : (
      <p class="posse so-sem-registro" data-rot-pt={ui('posse_sem_registro', 'pt')} data-rot-en={ui('posse_sem_registro', 'en')}>{ui('posse_sem_registro', 'pt')}</p>
    )}

    {pal.elementos?.length > 0 && (
      <p class="elementos">
        {pal.elementos.map((e) => (
          <span class="elemento" data-rot-pt={e.pt} data-rot-en={e.en}>{e.pt}</span>
        ))}
      </p>
    )}

    {nossa && (
      <aside class="adm adm-destaque" data-rotulo={ui('pal_nossa_analise', 'pt')}>
        {nossa.efeito && <p><strong>{nossa.efeito}</strong></p>}
        {nossa.onde && <p>{nossa.onde}</p>}
        {nossa.nota && <p>{nossa.nota}</p>}
        {nossa.aura && (
          <p>
            <span data-rot-pt={ui('pals_aura', 'pt')} data-rot-en={ui('pals_aura', 'en')}>{ui('pals_aura', 'pt')}</span>{' '}
            <span data-rot-pt={rotuloApt(nossa.aura).pt} data-rot-en={rotuloApt(nossa.aura).en}>{rotuloApt(nossa.aura).pt}</span>
          </p>
        )}
      </aside>
    )}

    <h2 data-rot-pt={termo('apt', 'pt')} data-rot-en={termo('apt', 'en')}>{termo('apt', 'pt')}</h2>
    {aptidoes.length === 0 ? (
      <p data-rot-pt={ui('pal_sem_apt', 'pt')} data-rot-en={ui('pal_sem_apt', 'en')}>{ui('pal_sem_apt', 'pt')}</p>
    ) : (
      <div class="aptidoes">
        {aptidoes.map(([chave, nivel]) => (
          <div class="apt-linha">
            <span class="nome" data-rot-pt={rotuloApt(chave).pt} data-rot-en={rotuloApt(chave).en}>{rotuloApt(chave).pt}</span>
            <span class="apt-barra" role="img" aria-label={`${rotuloApt(chave).pt} ${nivel} de 10`}>
              <i data-nivel={nivel} style={`width:${nivel * 10}%`}></i>
            </span>
            <span class="v">{nivel}</span>
          </div>
        ))}
      </div>
    )}

    {!nossa && (
      <p class="sem-curadoria">
        <span data-rot-pt={ui('pal_sem_curadoria', 'pt')} data-rot-en={ui('pal_sem_curadoria', 'en')}>{ui('pal_sem_curadoria', 'pt')}</span>{' '}
        <a
          href={`${REPO}/blob/main/CONTRIBUINDO.md`}
          data-rot-pt={ui('pal_contribuir', 'pt')}
          data-rot-en={ui('pal_contribuir', 'en')}
        >{ui('pal_contribuir', 'pt')}</a>
      </p>
    )}

    <h2 data-rot-pt={ui('pal_nos_guias', 'pt')} data-rot-en={ui('pal_nos_guias', 'en')}>{ui('pal_nos_guias', 'pt')}</h2>
    {guias.length === 0 ? (
      <p data-rot-pt={ui('pal_sem_guias', 'pt')} data-rot-en={ui('pal_sem_guias', 'en')}>{ui('pal_sem_guias', 'pt')}</p>
    ) : (
      <ul class="guias">
        {guias.map((g) => (
          <li>
            <span class="guia" data-rot-pt={g.titulo} data-rot-en={g.titulo_en || g.titulo}>{g.titulo}</span>
            <span class="secoes">
              {g.secoes.map((s) => (
                <a href={`${base}/${g.id}/#${s.ancora}`}>{s.texto || ui('pal_guia_topo', 'pt')}</a>
              ))}
            </span>
          </li>
        ))}
      </ul>
    )}
  </article>
</Base>

<style>
  .posse { margin: 12px 0 0; font-family: var(--sans); font-size: 13px; }
  .marca-posse {
    display: inline-block; padding: 3px 10px; margin: 0 6px 4px 0;
    border: 1px solid var(--acento-2); border-radius: 20px; color: var(--acento-2);
  }
  .marca-posse.vencida { border-color: var(--linha); color: var(--apagado); }
  .so-sem-registro { color: var(--apagado); }
  .elementos { display: flex; gap: 7px; flex-wrap: wrap; margin: 14px 0 4px; }
  .elemento {
    font-family: var(--sans); font-size: 12px; padding: 2px 9px;
    border: 1px solid var(--linha); border-radius: 20px; color: var(--texto-2);
  }
  .aptidoes { margin: 14px 0 4px; max-width: 460px; }
  .apt-linha {
    display: grid; grid-template-columns: 150px 1fr 22px;
    align-items: center; gap: 10px; margin: 6px 0;
    font-family: var(--sans);
  }
  .apt-linha .nome { font-size: 12.5px; color: var(--texto-2); }
  .apt-barra { height: 7px; background: var(--cartao); border-radius: 4px; overflow: hidden; }
  .apt-barra i { display: block; height: 100%; background: var(--acento); border-radius: 0 4px 4px 0; }
  .apt-linha .v {
    font-size: 12.5px; text-align: right; color: var(--texto);
    font-weight: 600; font-variant-numeric: tabular-nums;
  }
  .sem-curadoria { font-size: 14px; color: var(--apagado); margin-top: 16px; }
  .guias { margin: 10px 0 0 20px; }
  .guias li { margin-bottom: 6px; }
  .guias .guia { font-weight: 600; }
  .guias .secoes { display: block; font-size: 13px; }
  .guias .secoes a + a::before { content: ' · '; color: var(--apagado); }
</style>
