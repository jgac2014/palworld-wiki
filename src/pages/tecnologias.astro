---
import Base from '../layouts/Base.astro';
import IndiceCatalogo from '../components/IndiceCatalogo.astro';
import colecao from '../data/tecnologias.json';
import { ui } from '../lib/termos.js';

// Ordenada por nível de desbloqueio, que é a ordem em que alguém joga.
//
// O `tipo` vem cru do paldb, em inglês: 371 "Items" e 217 "Structures". A
// tradução mora no dicionário de interface e é aplicada aqui, na exibição.
// Traduzir na importação gravaria texto que ninguém reconfere contra a fonte,
// e é a regra que este repositório já aplica ao resto do catálogo.
//
// Valor que não estiver no dicionário sai como veio, e o verificador reprova:
// publicar em inglês em silêncio é o que criou esta tarefa.
// ui() devolve a própria chave quando ela não existe, então "|| x.tipo" nunca
// dispararia e a tela mostraria "tipo_Foo". Cai para o valor cru, e quem acusa
// a falta é o verificador.
const tipoEm = (tipo: string, idioma: 'pt' | 'en') => {
  const rotulo = ui(`tipo_${tipo}`, idioma);
  return rotulo === `tipo_${tipo}` ? tipo : rotulo;
};

const itens = [...colecao.itens]
  .sort((a, b) => a.nivel - b.nivel || a.custo - b.custo)
  .map((x) => ({
    ...x,
    tipo_mostrado: tipoEm(x.tipo, 'pt'),
    tipo_mostrado_en: tipoEm(x.tipo, 'en'),
  }));
---
<Base
  titulo={ui('nav_tecnologias', 'pt')}
  descricao="A árvore de tecnologia de Palworld 1.0 com nível de desbloqueio e custo em pontos, nos dois idiomas."
  largura="cheia"
>
  <article data-pagefind-body>
    <h1 data-rot-pt={ui('nav_tecnologias', 'pt')} data-rot-en={ui('nav_tecnologias', 'en')}>{ui('nav_tecnologias', 'pt')}</h1>
    <IndiceCatalogo
      itens={itens}
      subtituloChave="indice_tecnologias_sub"
      colunas={[
        { campo: 'nivel', chaveRotulo: 'indice_col_nivel' },
        { campo: 'custo', chaveRotulo: 'indice_col_custo' },
        { campo: 'tipo_mostrado', campoEn: 'tipo_mostrado_en', chaveRotulo: 'indice_col_tipo' },
      ]}
    />
  </article>
</Base>
