---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { ui } from '../lib/termos.js';
import { dataBr } from '../lib/datas.js';

export async function getStaticPaths() {
  const paginas = await getCollection('wiki', ({ data }) => !data.rascunho);
  return paginas.map((pagina) => ({
    params: { slug: pagina.id },
    props: { pagina },
  }));
}

const { pagina } = Astro.props;
const { Content } = await render(pagina);

// A moldura da página alterna, o corpo do guia não, por R2.7 do PRD.
//
// O inglês cai no português quando não existe, e não em vazio: campo opcional
// de propósito, para que página nova sem tradução continue legível em vez de
// aparecer sem título. É a mesma regra que o menu e a home já seguem.
const titulo = { pt: pagina.data.titulo, en: pagina.data.titulo_en || pagina.data.titulo };
const descricao = { pt: pagina.data.descricao, en: pagina.data.descricao_en || pagina.data.descricao };
const dia = dataBr(pagina.data.atualizado);
const carimbo = {
  pt: ui('guia_carimbo', 'pt').replace('{n}', dia),
  en: ui('guia_carimbo', 'en').replace('{n}', dia),
};
---
<Base
  titulo={pagina.data.titulo}
  descricao={pagina.data.descricao}
  atualizado={pagina.data.atualizado}
  arquivoFonte={`${pagina.id}.md`}
>
  {/*
    O id do topo existe para a seção "Onde aparece nos guias" das fichas de
    Pal ter para onde apontar quando a citação está antes do primeiro
    subtítulo. São 29 das 415 citações, e sem uma âncora de verdade elas
    voltariam a ser link para o topo de um guia de dez mil caracteres.
  */}
  <article data-pagefind-body id="topo">
    <h1 data-rot-pt={titulo.pt} data-rot-en={titulo.en}>{titulo.pt}</h1>
    <p class="subtitulo" data-rot-pt={descricao.pt} data-rot-en={descricao.en}>{descricao.pt}</p>
    <div class="carimbo" data-rot-pt={carimbo.pt} data-rot-en={carimbo.en}>{carimbo.pt}</div>
    <Content />
  </article>
</Base>
