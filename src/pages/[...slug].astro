---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const paginas = await getCollection('wiki', ({ data }) => !data.rascunho);
  return paginas.map((pagina) => ({
    params: { slug: pagina.id },
    props: { pagina },
  }));
}

const { pagina } = Astro.props;
const { Content } = await render(pagina);
---
<Base
  titulo={pagina.data.titulo}
  descricao={pagina.data.descricao}
  atualizado={pagina.data.atualizado}
  arquivoFonte={`${pagina.id}.md`}
>
  <article data-pagefind-body>
    <h1>{pagina.data.titulo}</h1>
    <p class="subtitulo">{pagina.data.descricao}</p>
    <div class="carimbo">Palworld 1.0.2 · atualizado 30.07.2026</div>
    <Content />
  </article>
</Base>
