---
/**
 * Banco de Pals, no formato do protótipo: cartão com barra de aptidão em vez
 * de número solto numa tabela.
 *
 * Cobre os 299 do catálogo, não os 77 com curadoria. A ficha de cada Pal
 * existe desde a E1, e listar 77 aqui deixaria 222 páginas alcançáveis só pela
 * busca. Quem filtra por Garimpo quer o melhor Pal de Garimpo do jogo, não o
 * melhor entre os que a gente já comentou.
 *
 * A curadoria não sumiu: quando existe, ela aparece no cartão e dá para filtrar
 * só por quem tem. Cobertura e opinião convivem, que é a divisão do PRD 3.1.
 */
import Base from '../layouts/Base.astro';
import catalogo from '../data/catalogo.json';
import curadoria from '../data/pals.json';
import { ui, rotuloApt } from '../lib/termos.js';
import { enderecoPal } from '../lib/enderecos.js';
import { quemTem } from '../lib/progresso.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nossa = new Map(curadoria.pals.map((p) => [p.nome, p]));

const pals = catalogo.pals.map((p) => {
  const c = nossa.get(p.en);
  return {
    ...p,
    endereco: `${base}/pal/${enderecoPal(p.chave)}`,
    aptOrdenada: Object.entries(p.apt || {}).sort((a, b) => b[1] - a[1]),
    fase: c?.fase || null,
    nota: c?.nota || c?.efeito || null,
    posse: quemTem(p.en),
  };
});

// As aptidões que realmente aparecem no catálogo, na ordem do dicionário.
const chavesApt = Object.keys(curadoria.aptidoes)
  .filter((k) => pals.some((p) => p.apt?.[k]));
const fases = ['mid', 'endgame', 'aura', 'utilidade', 'fazenda', 'combate'];

// O subtítulo diz as três partes porque o número sozinho contradizia a home:
// 299 aqui contra 287 lá, sem nada explicando a diferença. Os dois lados saem
// do mesmo dado agora, e a conta aparece em vez de ser escondida.
const naPalpedia = pals.filter((p) => p.numero != null).length;
const subtitulo = (l) =>
  ui('pals_sub', l)
    .replace('{n}', pals.length)
    .replace('{p}', naPalpedia)
    .replace('{c}', pals.length - naPalpedia);
const rotContagem = {
  pt: { pals: ui('pals_contagem', 'pt'), de: ui('pals_de', 'pt'), nenhum: ui('pals_nenhum', 'pt') },
  en: { pals: ui('pals_contagem', 'en'), de: ui('pals_de', 'en'), nenhum: ui('pals_nenhum', 'en') },
};
---
<Base
  titulo={ui('pals_titulo', 'pt')}
  descricao="Todos os Pals de Palworld 1.0 com aptidões de trabalho em português, filtráveis por função, fase do jogo e nível."
  largura="cheia"
>
  <article>
    <h1 data-rot-pt={ui('pals_titulo', 'pt')} data-rot-en={ui('pals_titulo', 'en')}>{ui('pals_titulo', 'pt')}</h1>
    <p class="subtitulo" data-rot-pt={subtitulo('pt')} data-rot-en={subtitulo('en')}>{subtitulo('pt')}</p>
    <div class="carimbo" data-rot-pt={ui('pals_carimbo', 'pt')} data-rot-en={ui('pals_carimbo', 'en')}>{ui('pals_carimbo', 'pt')}</div>

    <div class="controles">
      <input
        type="search"
        id="txt"
        placeholder={ui('pals_filtro', 'pt')}
        data-ph-pt={ui('pals_filtro', 'pt')}
        data-ph-en={ui('pals_filtro', 'en')}
      />
      <select id="apt">
        <option value="" data-rot-pt={ui('pals_todas_apt', 'pt')} data-rot-en={ui('pals_todas_apt', 'en')}>{ui('pals_todas_apt', 'pt')}</option>
        {chavesApt.map((k) => <option value={k} data-rot-pt={rotuloApt(k).pt} data-rot-en={rotuloApt(k).en}>{rotuloApt(k).pt}</option>)}
      </select>
      <select id="fase">
        <option value="" data-rot-pt={ui('pals_todas_fases', 'pt')} data-rot-en={ui('pals_todas_fases', 'en')}>{ui('pals_todas_fases', 'pt')}</option>
        {fases.map((f) => (
          <option value={f} data-rot-pt={ui(`fase_${f}`, 'pt')} data-rot-en={ui(`fase_${f}`, 'en')}>{ui(`fase_${f}`, 'pt')}</option>
        ))}
      </select>
      <label class="so-curadoria">
        <input type="checkbox" id="curadoria" />
        <span data-rot-pt={ui('pals_com_curadoria', 'pt')} data-rot-en={ui('pals_com_curadoria', 'en')}>{ui('pals_com_curadoria', 'pt')}</span>
      </label>
      <button id="limpar" type="button" data-rot-pt={ui('busca_limpar', 'pt')} data-rot-en={ui('busca_limpar', 'en')}>{ui('busca_limpar', 'pt')}</button>
    </div>

    <p class="contagem" id="contagem"></p>

    <div class="grade" id="grade">
      {pals.map((p) => (
        <article
          class="cartao"
          data-nome={p.en.toLowerCase()}
          data-fase={p.fase || ''}
          data-curadoria={p.nota ? '1' : ''}
          data-apt={p.aptOrdenada.map(([k, v]) => `${k}:${v}`).join(' ')}
          data-busca={`${p.en} ${p.pt} ${(p.elementos || []).map((e) => `${e.en} ${e.pt}`).join(' ')} ${p.nota || ''}`.toLowerCase()}
        >
          <header>
            <a href={p.endereco} data-rot-pt={p.pt} data-rot-en={p.en}>{p.pt}</a>
            {p.numero && <span class="numero">#{p.numero}</span>}
          </header>
          {p.posse.length > 0 && (
            <p class="posse-cartao so-com-progresso" data-lido-em={p.posse[0].lido_em}>
              <span aria-hidden="true">✓</span>{' '}
              <span data-rot-pt={ui(p.posse[0].onde === 'squad' ? 'posse_squad' : 'posse_palbox', 'pt')} data-rot-en={ui(p.posse[0].onde === 'squad' ? 'posse_squad' : 'posse_palbox', 'en')}>{ui(p.posse[0].onde === 'squad' ? 'posse_squad' : 'posse_palbox', 'pt')}</span>
              {' '}{p.posse[0].pessoa}
            </p>
          )}
          {p.elementos?.length > 0 && (
            <p class="elems">
              {p.elementos.map((e) => <span class="elem" data-rot-pt={e.pt} data-rot-en={e.en}>{e.pt}</span>)}
            </p>
          )}
          {p.aptOrdenada.map(([k, v]) => (
            <div class="apt-linha">
              <span class="nome" data-rot-pt={rotuloApt(k).pt} data-rot-en={rotuloApt(k).en}>{rotuloApt(k).pt}</span>
              <span class="apt-barra" role="img" aria-label={`${rotuloApt(k).pt} ${v} de 10`}>
                <i data-nivel={v} style={`width:${v * 10}%`}></i>
              </span>
              <span class="v">{v}</span>
            </div>
          ))}
          {p.nota && <p class="nota">{p.nota}</p>}
        </article>
      ))}
    </div>

    <details class="tabela-alternativa">
      <summary data-rot-pt={ui('pals_tabela', 'pt')} data-rot-en={ui('pals_tabela', 'en')}>{ui('pals_tabela', 'pt')}</summary>
      <div class="rolagem">
        <table>
          <thead>
            <tr>
              <th data-rot-pt={ui('pals_col_pal', 'pt')} data-rot-en={ui('pals_col_pal', 'en')}>{ui('pals_col_pal', 'pt')}</th>
              <th data-rot-pt={ui('pals_col_apt', 'pt')} data-rot-en={ui('pals_col_apt', 'en')}>{ui('pals_col_apt', 'pt')}</th>
              <th data-rot-pt={ui('pals_col_obs', 'pt')} data-rot-en={ui('pals_col_obs', 'en')}>{ui('pals_col_obs', 'pt')}</th>
            </tr>
          </thead>
          <tbody>
            {pals.map((p) => (
              <tr>
                <td><a href={p.endereco} data-rot-pt={p.pt} data-rot-en={p.en}>{p.pt}</a></td>
                <td>{p.aptOrdenada.map(([k, v]) => `${rotuloApt(k).pt} ${v}`).join(' · ')}</td>
                <td>{p.nota || ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>

    <h2 data-rot-pt={ui('pals_como_ler', 'pt')} data-rot-en={ui('pals_como_ler', 'en')}>{ui('pals_como_ler', 'pt')}</h2>
    <p>
      A escala foi de 4 para 10 níveis no 1.0, e a curva é fortemente não linear. Em Acender fogo,
      o nível 1 rende 50 pontos de trabalho, o 7 rende 1.100, o 8 rende 1.900 e o 10 rende 5.400.
      Como referência, o antigo nível 4 já rendia 5.400: ou seja, um Pal nível 8 de hoje é pior que
      o nível 4 de antes, e só o 10 empata.
    </p>
    <p>
      A consequência prática é que <strong>Pal de função única vence Pal versátil</strong> para trabalho.
      Cada rank de condensação sobe apenas uma aptidão, então num Pal com três funções o ganho se
      espalha. Anubis começa em Trabalho manual 6 e para em 8 mesmo no 4 estrelas, enquanto Jormuntide
      Ignis começa em Acender fogo 7 e chega a 10 com três estrelas.
    </p>

    <aside class="adm adm-destaque" data-rotulo="Importante">
      <p>
        Os números vêm do catálogo importado do paldb e não são digitados por ninguém. A análise
        escrita, que aparece no fim de alguns cartões, é nossa e cobre só os Pals que a wiki
        realmente usa. Para escrever uma, edite <code>src/data/pals.json</code> pelo GitHub: copie
        um bloco, cole no fim e ajuste. Se não souber um número, omita em vez de chutar, porque o
        verificador compara o que você escrever com o catálogo.
      </p>
    </aside>
  </article>
</Base>

<style>
  .controles { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin: 20px 0 12px; font-family: var(--sans); }
  .controles input[type="search"], .controles select, .controles button {
    background: var(--cartao);
    border: 1px solid var(--linha);
    color: var(--texto);
    padding: 9px 12px;
    border-radius: 3px;
    font-size: 13.5px;
    font-family: var(--sans);
    outline: none;
  }
  .controles input[type="search"] { flex: 1; min-width: 200px; }
  .controles input:focus, .controles select:focus { border-color: var(--acento); }
  .controles button { cursor: pointer; color: var(--apagado); }
  .controles button:hover { border-color: var(--acento); color: var(--acento); }
  .so-curadoria { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--texto-2); cursor: pointer; }
  .so-curadoria input { accent-color: var(--acento); cursor: pointer; }
  .contagem { font-family: var(--sans); font-size: 12.5px; color: var(--apagado); margin-bottom: 10px; }

  /*
   * 250px e não 258px: com a coluna larga da F4, 258 fazia 4 cartões caberem
   * por 28px de folga em 1440, e barra de rolagem de sistema come mais que
   * isso. Cair para 250 dá 45px de folga e mantém a quarta coluna em pé no
   * navegador de verdade, não só na medição headless.
   */
  .grade { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 12px; }
  .cartao {
    background: var(--cartao);
    border: 1px solid var(--linha);
    border-radius: 4px;
    padding: 12px 14px 10px;
    font-family: var(--sans);
  }
  .cartao.escondido { display: none; }
  .cartao header { display: flex; align-items: baseline; gap: 8px; margin-bottom: 6px; }
  .cartao header a { font-size: 15px; font-weight: 600; text-decoration: none; }
  .cartao header a:hover { text-decoration: underline; }
  .cartao .numero { font-size: 11.5px; color: var(--apagado); margin-left: auto; }
  .posse-cartao { font-size: 11.5px; color: var(--acento-2); margin: 0 0 6px; }
  .elems { display: flex; flex-wrap: wrap; gap: 5px; margin: 0 0 8px; }
  .elem { font-size: 11px; padding: 1px 8px; border: 1px solid var(--linha); border-radius: 20px; color: var(--texto-2); }
  .apt-linha { display: grid; grid-template-columns: 108px 1fr 18px; align-items: center; gap: 8px; margin: 4px 0; }
  .apt-linha .nome { font-size: 11.5px; color: var(--texto-2); }
  .apt-barra { height: 6px; background: var(--fundo); border-radius: 4px; overflow: hidden; }
  .apt-barra i { display: block; height: 100%; background: var(--acento); border-radius: 0 4px 4px 0; }
  .apt-linha .v { font-size: 11.5px; text-align: right; color: var(--texto); font-weight: 600; font-variant-numeric: tabular-nums; }
  .cartao .nota {
    font-size: 12px; color: var(--texto-2); margin: 9px 0 0;
    padding-top: 8px; border-top: 1px solid var(--linha); font-style: italic;
  }

  .tabela-alternativa { margin: 26px 0 0; font-family: var(--sans); font-size: 13px; }
  .tabela-alternativa summary { cursor: pointer; color: var(--acento-2); }
  .rolagem { overflow-x: auto; }
</style>

<script define:vars={{ rotContagem }}>
  const txt = document.getElementById('txt');
  const selApt = document.getElementById('apt');
  const selFase = document.getElementById('fase');
  const soCuradoria = document.getElementById('curadoria');
  const limpar = document.getElementById('limpar');
  const grade = document.getElementById('grade');
  const contagem = document.getElementById('contagem');
  const cartoes = Array.from(grade.querySelectorAll('.cartao'));

  const nivelDe = (cartao, chave) => {
    const par = cartao.dataset.apt.split(' ').find((x) => x.startsWith(chave + ':'));
    return par ? Number(par.split(':')[1]) : 0;
  };

  function filtrar() {
    const t = txt.value.trim().toLowerCase();
    const a = selApt.value;
    const f = selFase.value;
    let visiveis = 0;

    for (const c of cartoes) {
      const ok =
        (!t || c.dataset.busca.includes(t)) &&
        (!a || nivelDe(c, a) > 0) &&
        (!f || c.dataset.fase === f) &&
        (!soCuradoria.checked || c.dataset.curadoria === '1');
      c.classList.toggle('escondido', !ok);
      if (ok) visiveis++;
    }

    // Escolher uma aptidão ordena por ela, do maior para o menor: a pergunta
    // real é "qual o melhor de Garimpo", não "quais existem".
    if (a) {
      cartoes
        .slice()
        .sort((x, y) => nivelDe(y, a) - nivelDe(x, a) || x.dataset.nome.localeCompare(y.dataset.nome))
        .forEach((c) => grade.appendChild(c));
    }

    const escrever = (r) =>
      visiveis === 0 ? r.nenhum
      : visiveis === cartoes.length ? `${cartoes.length} ${r.pals}`
      : `${visiveis} ${r.de} ${cartoes.length} ${r.pals}`;
    contagem.dataset.rotPt = escrever(rotContagem.pt);
    contagem.dataset.rotEn = escrever(rotContagem.en);
    contagem.textContent =
      document.documentElement.dataset.idioma === 'en'
        ? contagem.dataset.rotEn
        : contagem.dataset.rotPt;
  }

  [txt, selApt, selFase, soCuradoria].forEach((el) => {
    el.addEventListener('input', filtrar);
    el.addEventListener('change', filtrar);
  });
  limpar.addEventListener('click', () => {
    txt.value = ''; selApt.value = ''; selFase.value = ''; soCuradoria.checked = false;
    filtrar();
  });

  filtrar();
</script>
