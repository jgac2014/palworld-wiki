---
import Base from '../layouts/Base.astro';
import dados from '../data/mapa.json';
// A conversão de coordenada do jogo para pixel deixou de ser dois pontos
// escritos à mão e passou a ser derivada dos limites de mundo que o paldb
// publica. Quem confere é o verificador, contra a própria fonte.
import projecao from '../data/projecao-mapa.json';
// O fundo em tiles. O manifesto diz qual imagem está em public/mapa/ e de que
// build ela é, e `npm run mapa:fundo` aborta se ela deixar de casar com os
// limites da build ativa.
import fundo from '../data/mapa-fundo.json';
// Os 13.755 pontos importados do paldb. Vão inteiros para o navegador porque o
// pacote offline é um arquivo só: buscar por rede mataria o caso de uso dele.
import pontos from '../data/mapa-pontos.json';
import { ui, termo, construirIndice } from '../lib/termos.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categorias = Object.entries(dados.categorias);
const total = dados.marcadores.length;

// Categoria sem string no Anexo A cai para o dicionário oficial, que é a mesma
// fonte dos nomes do jogo, e só depois para o nome cru do JSON. É o caso de
// "Viagem rápida", que o anexo esqueceu: traduzir na mão aqui seria inventar.
const porNome = new Map(construirIndice());
const rotCat = (chave, nome) => {
  const k = `cat_${chave}`;
  const pt = ui(k, 'pt');
  if (pt !== k) return { pt, en: ui(k, 'en') };
  const id = porNome.get(nome);
  return id ? { pt: termo(id, 'pt'), en: termo(id, 'en') } : { pt: nome, en: nome };
};
const subtitulo = (l) => ui('mapa_sub', l).replace('{n}', total);

// Uma cor por categoria do paldb. São 11, escolhidas para se distinguirem nos
// dois temas e não colidirem com as cores das nossas categorias.
const CORES = {
  Mine: '#c9a06a', Fishing: '#7fb8d9', Resource: '#8fbf6a', Eggs: '#d9b8e0',
  Collectibles: '#d4b158', NPCs: '#c98f8f', Locations: '#9fb8d4', Enemies: '#e07a5f',
  Other: '#9a9a9a', Oilrig: '#8f7fc9', _sem_categoria: '#6f6f6f',
};
// Quantos pontos cada categoria tem. Sem isso o controle de camadas pede que a
// pessoa marque uma caixa para descobrir se ela vale a pena: "Pesca" e "Sem
// categoria no paldb" parecem a mesma coisa até você ver 3.232 contra zero.
// A contagem é feita aqui, no build, e não no navegador: é dado que não muda.
const contaPaldb = {};
for (const chave of Object.keys(pontos.categorias)) contaPaldb[chave] = 0;
for (const p of [...pontos.pontos, ...pontos.extras]) {
  const cat = pontos.tipos[p.t]?.categoria;
  if (cat in contaPaldb) contaPaldb[cat]++;
}
const contaNossa = {};
for (const chave of Object.keys(dados.categorias)) contaNossa[chave] = 0;
for (const m of dados.marcadores) if (m.categoria in contaNossa) contaNossa[m.categoria]++;
const numero = (n, l) => n.toLocaleString(l === 'en' ? 'en-US' : 'pt-BR');

const catsPaldb = Object.entries(pontos.categorias)
  .map(([chave, nome]) => ({ chave, ...nome, cor: CORES[chave] || '#888', quantos: contaPaldb[chave] }))
  .sort((a, b) => a.pt.localeCompare(b.pt, 'pt-BR'));
const doPaldb = { categorias: pontos.categorias, tipos: pontos.tipos, pontos: pontos.pontos, extras: pontos.extras, cores: CORES };
// Rótulos que o script escreve em tempo de execução precisam viajar nos dois
// idiomas, senão trocar de idioma depois de buscar devolve a frase inicial.
const rotBusca = {
  pt: { nada: ui('mapa_busca_nada', 'pt'), conta: ui('mapa_busca_conta', 'pt'), corte: ui('mapa_busca_corte', 'pt'), curta: ui('mapa_busca_curta', 'pt'), ligou: ui('mapa_busca_ligou', 'pt'), nivel: ui('mapa_nivel', 'pt') },
  en: { nada: ui('mapa_busca_nada', 'en'), conta: ui('mapa_busca_conta', 'en'), corte: ui('mapa_busca_corte', 'en'), curta: ui('mapa_busca_curta', 'en'), ligou: ui('mapa_busca_ligou', 'en'), nivel: ui('mapa_nivel', 'en') },
};
// A leitura de coordenada é escrita pelo script, então os dois idiomas vão junto
const rotCoord = {
  pt: { atual: ui('mapa_coord_atual', 'pt'), clicado: ui('mapa_clicado', 'pt') },
  en: { atual: ui('mapa_coord_atual', 'en'), clicado: ui('mapa_clicado', 'en') },
};

// O que a textura de fundo NÃO tem, nomeado. A lista vem medida do manifesto e
// não digitada aqui: no dia em que a base for trocada, o aviso encolhe sozinho
// em vez de continuar avisando de ilha que já apareceu.
const semTerra = fundo.lugares_sem_terra;
const agrupados = (semTerra?.aglomerados || []).filter((g) => g.quantos > 1);
const sozinhos = semTerra?.isolados || [];
// A separação vem medida do manifesto, não refeita aqui: dois lugares
// classificando a mesma coisa divergem no dia em que um dos dois mudar.
const ilhasQueFaltam = semTerra?.ilhas || [];
const outrosQueFaltam = semTerra?.outros || [];
const listar = (ls, l) => ls.map((x) => (l === 'en' ? x.en : x.pt)).join(', ');
---
<Base
  titulo={ui('mapa_titulo', 'pt')}
  descricao="Mapa de Palpagos com as coordenadas do jogo: bases da guilda, spots de minério e quartzo, torres e zonas de caça proibida."
  usaProgresso
>
  <article>
    <h1 data-rot-pt={ui('mapa_titulo', 'pt')} data-rot-en={ui('mapa_titulo', 'en')}>{ui('mapa_titulo', 'pt')}</h1>
    <p class="subtitulo" data-rot-pt={subtitulo('pt')} data-rot-en={subtitulo('en')}>{subtitulo('pt')}</p>
    <div class="carimbo" data-rot-pt={ui('mapa_dica', 'pt')} data-rot-en={ui('mapa_dica', 'en')}>{ui('mapa_dica', 'pt')}</div>

    <div class="busca-mapa">
      <input
        type="search"
        id="busca-mapa"
        autocomplete="off"
        placeholder={ui('mapa_busca', 'pt')}
        data-ph-pt={ui('mapa_busca', 'pt')}
        data-ph-en={ui('mapa_busca', 'en')}
      />
      <p class="achados" id="busca-conta" role="status" aria-live="polite"></p>
      <ul class="achados-lista" id="busca-lista"></ul>
    </div>

    <div id="filtros" class="filtros">
      {categorias.map(([chave, cat]) => (
        <label class={`filtro${cat.nosso ? ' so-com-progresso' : ''}`}>
          <input type="checkbox" value={chave} checked />
          <span class="ponto" style={`background:${cat.cor}`}></span>
          <span data-rot-pt={rotCat(chave, cat.nome).pt} data-rot-en={rotCat(chave, cat.nome).en}>{rotCat(chave, cat.nome).pt}</span>
          <span class="quantos" data-rot-pt={numero(contaNossa[chave], 'pt')} data-rot-en={numero(contaNossa[chave], 'en')}>{numero(contaNossa[chave], 'pt')}</span>
        </label>
      ))}
    </div>

    <div class="filtros" id="filtros-paldb">
      {catsPaldb.map((c) => (
        <label class="filtro">
          <input type="checkbox" value={c.chave} />
          <span class="ponto" style={`background:${c.cor}`}></span>
          <span data-rot-pt={c.pt} data-rot-en={c.en}>{c.pt}</span>
          <span class="quantos" data-rot-pt={numero(c.quantos, 'pt')} data-rot-en={numero(c.quantos, 'en')}>{numero(c.quantos, 'pt')}</span>
        </label>
      ))}
    </div>

    <aside class="adm adm-atencao" data-rotulo="A base do mapa está velha">
      <p>
        A imagem de fundo é anterior ao 1.0. Os pontos são do 1.0 e estão no lugar certo. A base é
        trocada quando a extração do jogo ficar pronta.
      </p>
      <p>
        <b>O que falta não é genérico, é medido e tem nome.</b> Destes {semTerra.de_quantos_lugares} lugares
        que o jogo nomeia, {semTerra.quantos} não têm terra nenhuma nesta textura:
      </p>
      <ul>
        <li>
          <b>As {ilhasQueFaltam.length} ilhas pequenas do lançamento</b>, todas em mar aberto aqui:
          <span data-rot-pt={listar(ilhasQueFaltam, 'pt')} data-rot-en={listar(ilhasQueFaltam, 'en')}>{listar(ilhasQueFaltam, 'pt')}</span>.
        </li>
        {agrupados.map((g) => (
          <li>
            <b>A região nova do 1.0</b>, Sunreach, em torno de {g.x.toFixed(0)}, {g.y.toFixed(0)}, com
            os {g.quantos} lugares dela:
            <span data-rot-pt={listar(g.lugares, 'pt')} data-rot-en={listar(g.lugares, 'en')}>{listar(g.lugares, 'pt')}</span>.
          </li>
        ))}
        {outrosQueFaltam.length > 0 && (
          <li>
            <b>E mais {outrosQueFaltam.length}</b>, que não {outrosQueFaltam.length === 1 ? 'é ilha' : 'são ilhas'}:
            <span data-rot-pt={listar(outrosQueFaltam, 'pt')} data-rot-en={listar(outrosQueFaltam, 'en')}>{listar(outrosQueFaltam, 'pt')}</span>.
          </li>
        )}
      </ul>
      <p>
        Se um marcador seu cair em cima de água, é provável que seja um destes: a água é que está
        desatualizada, não a coordenada.
      </p>
    </aside>

    <div id="mapa"></div>

    <div class="coord-atual" id="coord" data-rot-pt={ui('mapa_coord', 'pt')} data-rot-en={ui('mapa_coord', 'en')}>{ui('mapa_coord', 'pt')}</div>

    <p class="contagem" id="contagem-mapa"></p>
    <div class="rolagem">
      <table class="alternativa">
        <thead>
          <tr>
            <th data-rot-pt="Ponto" data-rot-en="Point">Ponto</th>
            <th data-rot-pt="Tipo" data-rot-en="Type">Tipo</th>
            <th data-rot-pt="Coordenada" data-rot-en="Coordinate">Coordenada</th>
          </tr>
        </thead>
        <tbody id="tabela-mapa"></tbody>
      </table>
    </div>

    <h2 data-rot-pt={ui('mapa_como_add', 'pt')} data-rot-en={ui('mapa_como_add', 'en')}>{ui('mapa_como_add', 'pt')}</h2>
    <p>
      Todos os pontos ficam num único arquivo, <code>src/data/mapa.json</code>. Dá para editar direto pelo
      site do GitHub, sem instalar nada: abra o arquivo, clique no lápis, copie um bloco existente e troque
      os valores. As coordenadas <code>x</code> e <code>y</code> são exatamente as que aparecem no canto da
      tela quando você abre o mapa no jogo.
    </p>

    <aside class="adm adm-nota" data-rotulo="De onde vem o fundo, e como trocar">
      <p>
        O fundo são {fundo.tiles.total} tiles de {fundo.tiles.lado} px em {fundo.tiles.niveis} níveis,
        gerados por <code>npm run mapa:fundo</code> a partir da textura que a wiki.gg publica. Não há
        calibração para ajustar à mão: o enquadramento vem dos limites que a própria fonte declara, e
        o script <b>aborta sem escrever tile</b> se eles deixarem de bater com
        <code>src/data/projecao-mapa.json</code>.
      </p>
      <p>
        Trocar a base pela extração do 1.0 é trocar <code>build_ativa</code> nesse arquivo e rodar o
        script de novo. Os limites das duas builds ficam guardados lado a lado: coordenada de mundo
        não muda entre versões, só o retângulo que a textura cobre. Casar imagem de uma build com
        limite da outra erra 6,8% do lado do mapa.
      </p>
    </aside>

    <aside class="adm adm-nota" data-rotulo="Nota">
      <p>
        <b>No pacote offline esta página é só texto.</b> O mapa interativo depende do Leaflet, que é
        carregado da rede, e os 13.755 pontos do paldb ficam de fora do arquivo único: eles moram num
        bloco de dados fora do corpo da página, que é o que o empacotador leva. <b>Os tiles do fundo
        também ficam de fora</b>, e são {fundo.tiles.total} arquivos somando 4,4 MB, que não caberiam
        no teto de 8 MB junto com o resto. Medido em 01.08: a página serve 897 KB no site e contribui
        12,0 KB para o pacote, que fechou em 3,72 MB. Está escrito aqui porque corte em silêncio é o
        que este projeto proíbe.
      </p>
    </aside>

    <p class="creditos">
      Imagem de fundo: <a href="https://palworld.wiki.gg/wiki/Map:Fragments/Core" rel="noopener">palworld.wiki.gg</a>.
      Palworld © Pocketpair, Inc. Coordenadas dos pontos: paldb.cc.
      Projeto de fã, sem vínculo com a Pocketpair.
    </p>
  </article>
</Base>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
  .filtros { display: flex; flex-wrap: wrap; gap: 8px 16px; margin: 18px 0 14px; font-family: var(--sans); font-size: 13px; }
  .filtro { display: flex; align-items: center; gap: 6px; cursor: pointer; color: var(--texto-2); user-select: none; }
  .filtro input { accent-color: var(--acento); cursor: pointer; }
  .ponto { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .quantos { font-variant-numeric: tabular-nums; font-size: 11.5px; color: var(--apagado); }

  /* --- busca no mapa --- */
  .busca-mapa { margin: 18px 0 0; font-family: var(--sans); }
  .busca-mapa input {
    width: 100%; padding: 9px 11px; font: inherit; font-size: 14px;
    background: var(--cartao); color: var(--texto);
    border: 1px solid var(--linha); border-radius: 3px;
  }
  .busca-mapa input:focus-visible { outline: 2px solid var(--acento); outline-offset: 1px; }
  .achados { font-size: 12.5px; color: var(--texto-2); margin: 8px 0 0; }
  .achados:empty { display: none; }
  .achados-lista { list-style: none; margin: 6px 0 0; padding: 0; max-height: 240px; overflow-y: auto; }
  .achados-lista:empty { display: none; }
  /* :global porque o `li` e o `button` nascem do script, e elemento criado em
     tempo de execução não recebe o atributo de escopo que o Astro põe no HTML.
     Sem isto a lista sai sem estilo nenhum: os campos colam uns nos outros e o
     botão aparece com a moldura padrão do navegador. Foi assim que ela saiu na
     primeira tentativa, e só apareceu numa imagem. */
  .achados-lista :global(li) { margin: 0; }
  .achados-lista :global(button) {
    display: flex; align-items: center; gap: 8px; width: 100%; text-align: left;
    padding: 6px 8px; font: inherit; font-size: 13px; color: var(--texto);
    background: none; border: 0; border-radius: 3px; cursor: pointer;
  }
  .achados-lista :global(button:hover), .achados-lista :global(button:focus-visible) { background: var(--bloco); }
  .achados-lista :global(.ponto) { flex: none; width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .achados-lista :global(.onde) { margin-left: auto; color: var(--apagado); font-family: ui-monospace, monospace; font-size: 11.5px; }
  .achados-lista :global(.qual) { color: var(--texto-2); }
  .achados-lista :global(.nome) { font-weight: 600; }

  /* --- etiqueta de nível no marcador de alfa --- */
  /* Ela é DOM e não canvas, ao contrário dos outros 13.755 pontos: número não
     se desenha em canvas do Leaflet, e são 83 alfas, um volume que o DOM
     aguenta. A camada de Inimigos nasce desligada, então ninguém paga por isso
     sem pedir. */
  /* Duas classes de propósito. A folha do Leaflet traz
     `.leaflet-marker-icon { display: block }`, com a mesma especificidade de
     `.alfa` e carregada DEPOIS, então ela vencia: a bola virava caixa em linha,
     de 2 por 16, e o número saía fora do lugar. Nada disso dá erro, o marcador
     continua no mapa, e só apareceu numa imagem. É primo da armadilha do
     `display: flex` contra `[hidden]` que o CLAUDE.md já registra. */
  :global(.leaflet-marker-icon.alfa) { display: flex; align-items: center; gap: 3px; white-space: nowrap; }
  :global(.alfa i) {
    width: 8px; height: 8px; flex: none; border-radius: 50%;
    background: var(--cor-alfa, #e07a5f);
    border: 1px solid rgba(0, 0, 0, .6);
  }
  :global(.alfa b) {
    font: 700 10.5px/1 var(--sans); color: #fff;
    text-shadow: 0 0 3px #000, 0 0 2px #000, 0 0 1px #000;
    font-variant-numeric: tabular-nums;
  }
  /* Longe, os 83 números se encavalam e "62" ao lado de "60" viram "6260": um
     número inventado com cara de número lido. Abaixo do nível 2 fica só a bola,
     e o número volta quando há espaço para ele. */
  #mapa[data-zoom="0"] :global(.alfa b),
  #mapa[data-zoom="1"] :global(.alfa b) { display: none; }
  #mapa {
    width: 100%;
    height: 560px;
    background: var(--bloco);
    border: 1px solid var(--linha);
    border-radius: 3px;
  }
  .coord-atual {
    font-family: ui-monospace, monospace;
    font-size: 12.5px;
    color: var(--apagado);
    padding: 8px 2px 0;
  }
  :global(.leaflet-container) { background: var(--bloco); font-family: var(--sans); }
  :global(.leaflet-popup-content-wrapper) {
    background: var(--cartao);
    color: var(--texto);
    border: 1px solid var(--linha);
    border-radius: 3px;
  }
  :global(.leaflet-popup-tip) { background: var(--cartao); border: 1px solid var(--linha); }
  :global(.leaflet-popup-content) { margin: 12px 14px; font-size: 13.5px; line-height: 1.55; }
  :global(.leaflet-popup-content b) { color: var(--forte); display: block; margin-bottom: 4px; font-size: 14.5px; }
  :global(.leaflet-popup-content .cd) { color: var(--apagado); font-family: ui-monospace, monospace; font-size: 12px; }
  :global(.leaflet-control-zoom a) { background: var(--cartao); color: var(--texto); border-color: var(--linha); }
  :global(.marcador) { border-radius: 50%; border: 2px solid rgba(0,0,0,.55); box-shadow: 0 0 0 1px rgba(255,255,255,.18); }
  .rolagem { overflow-x: auto; }
  .alternativa { font-size: 13.5px; width: 100%; }
  .alternativa td, .alternativa th { font-variant-numeric: tabular-nums; }
  .contagem { font-family: var(--sans); font-size: 12.5px; color: var(--texto-2); margin: 18px 0 6px; }
  .creditos { font-family: var(--sans); font-size: 12px; color: var(--apagado); margin-top: 26px; line-height: 1.6; }
  @media (max-width: 860px) { #mapa { height: 400px; } }
</style>

<script type="application/json" id="dados-paldb" set:html={JSON.stringify(doPaldb)} data-pagefind-ignore></script>

<script define:vars={{ dados, projecao, fundo, base, rotCoord, rotBusca }}>
  import('https://unpkg.com/leaflet@1.9.4/dist/leaflet-src.esm.js').then((L) => {
    const { categorias, marcadores } = dados;

    // --- coordenada do jogo para pixel da imagem ---
    // O enquadramento é o da build declarada em `build_ativa`, e não um par de
    // pontos calibrado à mão. Trocar a textura é trocar esse campo: coordenada
    // de mundo não muda entre versões, só o retângulo que a imagem cobre. O eixo
    // y é invertido porque a coordenada do jogo cresce para cima e o pixel cresce
    // para baixo.
    const T = projecao.limites_por_build[projecao.build_ativa];
    const LADO = fundo.imagem_original.largura;
    // O último nível da pirâmide é a resolução nativa, e é nele que 1 unidade de
    // coordenada do Leaflet vale 1 pixel da imagem original.
    const NATIVO = fundo.tiles.niveis - 1;
    const jogoParaPixel = (x, y) => [
      ((x - T.min_x) / T.lado) * LADO,
      (1 - (y - T.min_y) / T.lado) * LADO,
    ];
    const pixelParaJogo = (px, py) => [
      T.min_x + (px / LADO) * T.lado,
      T.min_y + (1 - py / LADO) * T.lado,
    ];

    const mapa = L.map('mapa', {
      crs: L.CRS.Simple,
      minZoom: 0,
      maxZoom: NATIVO + 1,
      // Zoom sem passo fixo. Com passo, o nível 0 da pirâmide (a imagem inteira
      // em 512 px) é o menor zoom possível e o `fitBounds` não consegue encostar
      // nas bordas do quadro: o mapa nascia com tarja em volta.
      zoomSnap: 0,
      attributionControl: false,
    });

    // Com tile, o espaço de coordenada é o pixel da imagem nativa, e quem
    // converte é o próprio mapa. Fazer a conta à mão daria índice de tile
    // negativo, porque em CRS.Simple o eixo y aponta para cima.
    const paraLatLng = (x, y) => mapa.unproject(jogoParaPixel(x, y), NATIVO);
    const doLatLng = (latlng) => {
      const p = mapa.project(latlng, NATIVO);
      return pixelParaJogo(p.x, p.y);
    };
    const limites = L.latLngBounds(
      mapa.unproject([0, 0], NATIVO),
      mapa.unproject([LADO, LADO], NATIVO),
    );

    // Fundo em tiles. Se eles não estiverem no lugar, o mapa cai para a grade de
    // coordenadas e DIZ que caiu, em vez de servir um fundo vazio que parece
    // oceano.
    let caiuParaGrade = false;
    const camadaFundo = L.tileLayer(base + fundo.tiles.caminho, {
      tileSize: fundo.tiles.lado,
      minNativeZoom: 0,
      maxNativeZoom: NATIVO,
      minZoom: 0,
      maxZoom: NATIVO + 1,
      noWrap: true,
      bounds: limites,
    });
    camadaFundo.on('tileerror', () => {
      if (caiuParaGrade) return;
      caiuParaGrade = true;
      mapa.removeLayer(camadaFundo);
      desenhaGrade();
      const saidaFalha = document.getElementById('coord');
      if (saidaFalha) {
        saidaFalha.dataset.rotPt = 'Os tiles do fundo não carregaram. O mapa está desenhando só a grade de coordenadas.';
        saidaFalha.dataset.rotEn = 'Background tiles failed to load. The map is drawing the coordinate grid only.';
        saidaFalha.textContent = document.documentElement.dataset.idioma === 'en'
          ? saidaFalha.dataset.rotEn : saidaFalha.dataset.rotPt;
      }
    });
    camadaFundo.addTo(mapa);

    function desenhaGrade() {
      const passo = 250;
      const [minX, minY] = pixelParaJogo(0, LADO);
      const [maxX, maxY] = pixelParaJogo(LADO, 0);
      const ini = (v) => Math.ceil(v / passo) * passo;
      for (let x = ini(minX); x <= maxX; x += passo) {
        const a = paraLatLng(x, minY), b = paraLatLng(x, maxY);
        L.polyline([a, b], { color: '#2b3125', weight: x === 0 ? 2 : 1 }).addTo(mapa);
        L.marker(paraLatLng(x, minY), {
          icon: L.divIcon({ className: 'rot', html: `<span style="color:#5c6152;font:11px monospace">${x}</span>` }),
          interactive: false,
        }).addTo(mapa);
      }
      for (let y = ini(minY); y <= maxY; y += passo) {
        const a = paraLatLng(minX, y), b = paraLatLng(maxX, y);
        L.polyline([a, b], { color: '#2b3125', weight: y === 0 ? 2 : 1 }).addTo(mapa);
        L.marker(paraLatLng(minX, y), {
          icon: L.divIcon({ className: 'rot', html: `<span style="color:#5c6152;font:11px monospace">${y}</span>` }),
          interactive: false,
        }).addTo(mapa);
      }
    }

    // --- marcadores por categoria ---
    const camadas = {};
    for (const chave of Object.keys(categorias)) camadas[chave] = L.layerGroup();

    // Índice único da busca: os nossos 35 marcadores e os 13.755 do paldb na
    // mesma lista, cada um sabendo em que camada mora. Sem isso, buscar um
    // ponto de camada desligada devolveria nada, e "não existe" e "está
    // desmarcado" seriam a mesma resposta na tela.
    const indiceBusca = [];

    // Categoria marcada como nossa no JSON é Camada 2: só entra no mapa com o
    // overlay ligado. Desligado, o mapa é o mapa do jogo e mais nada.
    const nossas = Object.keys(categorias).filter((c) => categorias[c].nosso);
    function aplicarOverlay() {
      const ligado = document.documentElement.hasAttribute('data-progresso');
      for (const [chave, camada] of Object.entries(camadas)) {
        const caixa = document.querySelector(`#filtros input[value="${chave}"]`);
        const deve = (!nossas.includes(chave) || ligado) && (caixa ? caixa.checked : true);
        if (deve) mapa.addLayer(camada); else mapa.removeLayer(camada);
      }
    }
    document.addEventListener('progresso:mudou', aplicarOverlay);

    for (const m of marcadores) {
      const cat = categorias[m.categoria] || { cor: '#999', nome: m.categoria };
      const marcador = L.circleMarker(paraLatLng(m.x, m.y), {
        radius: m.categoria === 'base' ? 9 : 6,
        color: 'rgba(0,0,0,.6)',
        weight: 2,
        fillColor: cat.cor,
        fillOpacity: 0.95,
        className: 'marcador',
      });
      marcador.bindPopup(
        `<b>${m.nome}</b>` +
        `<span class="cd">${cat.nome} · ${m.x}, ${m.y}</span>` +
        (m.nota ? `<p style="margin:6px 0 0">${m.nota}</p>` : '')
      );
      marcador.addTo(camadas[m.categoria] || mapa);
      indiceBusca.push({
        p: { x: m.x, y: m.y, pt: m.nome, en: m.nome, t: null },
        camada: m.categoria, cor: cat.cor, marcador, nosso: true,
        rotulo: { pt: cat.nome, en: cat.nome },
      });
    }

    // --- os 13.755 pontos do paldb, desenhados em CANVAS ---
    //
    // Marcador como elemento de DOM trava o navegador nesse volume, e agrupar
    // por proximidade resolveria o desempenho continuando a inchar o HTML.
    // L.canvas() é Leaflet base, não plugin, então não acrescenta dependência,
    // e o HTML deixa de crescer com o número de pontos: o custo passa a ser só
    // o JSON, que entra uma vez.
    const bruto = document.getElementById('dados-paldb');
    const P = bruto ? JSON.parse(bruto.textContent || '{}') : null;
    const camadasPaldb = {};
    const idioma = () => (document.documentElement.dataset.idioma === 'en' ? 'en' : 'pt');

    if (P) {
      const tela = L.canvas({ padding: 0.4 });
      const rotuloDoTipo = (t) => P.tipos[t] || { pt: t, en: t, categoria: 'Other' };
      const nomeDoPonto = (p) => {
        const l = idioma();
        return (l === 'en' ? p.en : p.pt || p.en) || rotuloDoTipo(p.t)[l];
      };
      for (const chave of Object.keys(P.categorias)) camadasPaldb[chave] = L.layerGroup();

      for (const p of [...P.pontos, ...P.extras]) {
        const tipo = rotuloDoTipo(p.t);
        const camada = camadasPaldb[tipo.categoria];
        if (!camada) continue;
        const cor = P.cores[tipo.categoria] || '#888';

        // O nível do alfa vai NO marcador, não só no popup. Quem abre esta
        // camada está escolhendo qual alfa dá para enfrentar agora, e ter que
        // clicar num ponto de cada vez para descobrir o nível transforma a
        // decisão numa caçada. Só o alfa ganha etiqueta: são 83, e o dado é
        // exatamente o que faz a pessoa ir ou não ir.
        const ehAlfa = p.t === 'Alpha Pal' && typeof p.lv === 'number';
        const c = ehAlfa
          ? L.marker(paraLatLng(p.x, p.y), {
              icon: L.divIcon({
                className: 'alfa',
                html: `<i style="--cor-alfa:${cor}"></i><b>${p.lv}</b>`,
                iconSize: [26, 12],
                iconAnchor: [5, 6],
              }),
              keyboard: false,
            })
          : L.circleMarker(paraLatLng(p.x, p.y), {
              renderer: tela,
              radius: 3.5,
              stroke: false,
              fillColor: cor,
              fillOpacity: 0.85,
            });
        c.dadosDoPonto = p;
        indiceBusca.push({ p, camada: tipo.categoria, cor, marcador: c, nosso: false, rotulo: tipo });
        c.bindPopup(() => {
          const l = idioma();
          return `<b>${nomeDoPonto(p)}</b><span class="cd">${tipo[l]} · ${p.x}, ${p.y}${typeof p.lv === 'number' ? ` · Lv.${p.lv}` : ''}</span>`;
        });
        c.addTo(camada);
      }

      // --- alternativa em tabela (R5.8) ---
      //
      // Ela mostra o que está FILTRADO na tela, não os 13.755. Tabela que
      // ninguém consegue ler não é alternativa acessível, é fachada. Quando o
      // filtro ainda deixa muita coisa, a tabela diz quantos são e quantos está
      // mostrando, em vez de cortar em silêncio.
      const TETO = 200;
      function pintarTabela() {
        const l = idioma();
        const visiveis = [];
        for (const [chave, camada] of Object.entries(camadasPaldb)) {
          if (!mapa.hasLayer(camada)) continue;
          camada.eachLayer((c) => visiveis.push(c.dadosDoPonto));
        }
        visiveis.sort((a, b) => nomeDoPonto(a).localeCompare(nomeDoPonto(b), 'pt-BR'));
        const corpo = document.getElementById('tabela-mapa');
        corpo.replaceChildren();
        for (const p of visiveis.slice(0, TETO)) {
          const tr = document.createElement('tr');
          // O nível entra na coluna do tipo, e não numa quarta coluna: só 914
          // dos 13.755 pontos têm nível, e uma coluna vazia em nove de cada dez
          // linhas atrapalha quem lê por leitor de tela. Se ele aparece no
          // marcador, precisa aparecer aqui: a tabela é a alternativa dele.
          const tipoComNivel = typeof p.lv === 'number'
            ? `${rotuloDoTipo(p.t)[l]} · ${rotBusca[l].nivel} ${p.lv}`
            : rotuloDoTipo(p.t)[l];
          for (const txt of [nomeDoPonto(p), tipoComNivel, `${p.x}, ${p.y}`]) {
            const td = document.createElement('td');
            td.textContent = txt;
            tr.appendChild(td);
          }
          corpo.appendChild(tr);
        }
        const cont = document.getElementById('contagem-mapa');
        if (!visiveis.length) {
          cont.textContent = l === 'en'
            ? 'No paldb category selected. Tick one above to list its points here.'
            : 'Nenhuma categoria do paldb marcada. Marque uma acima para listar os pontos dela aqui.';
        } else if (visiveis.length > TETO) {
          cont.textContent = l === 'en'
            ? `Showing the first ${TETO} of ${visiveis.length} points selected. Narrow the filter to read the rest.`
            : `Mostrando os primeiros ${TETO} de ${visiveis.length} pontos marcados. Estreite o filtro para ler o resto.`;
        } else {
          cont.textContent = l === 'en'
            ? `${visiveis.length} points selected.`
            : `${visiveis.length} pontos marcados.`;
        }
      }

      function aplicarPaldb() {
        for (const [chave, camada] of Object.entries(camadasPaldb)) {
          const caixa = document.querySelector(`#filtros-paldb input[value="${chave}"]`);
          if (caixa && caixa.checked) mapa.addLayer(camada); else mapa.removeLayer(camada);
        }
        pintarTabela();
      }
      document.querySelectorAll('#filtros-paldb input').forEach((cx) => cx.addEventListener('change', aplicarPaldb));
      document.addEventListener('idioma:mudou', pintarTabela);
      aplicarPaldb();
    }

    // O nível do zoom vira atributo no container: é o que permite ao CSS
    // esconder o número do alfa quando ele não cabe. Arredondado para baixo,
    // porque o zoom aqui é contínuo.
    const caixaDoMapa = document.getElementById('mapa');
    const marcarZoom = () => { caixaDoMapa.dataset.zoom = String(Math.floor(mapa.getZoom())); };
    mapa.on('zoomend', marcarZoom);

    mapa.fitBounds(limites);
    marcarZoom();

    // --- filtros ---
    document.querySelectorAll('#filtros input').forEach((cx) => {
      cx.addEventListener('change', aplicarOverlay);
    });
    aplicarOverlay();

    // --- busca no mapa ---
    //
    // Ela procura nos 13.755 do paldb E nos nossos 35, no nome e no tipo, nos
    // dois idiomas, com ou sem acento. Procurar só no que está marcado seria
    // pior que não ter busca: "não achei" e "está desmarcado" viram a mesma
    // resposta, e quem não sabe em que categoria o paldb pôs a coisa nunca
    // descobre. Achar um ponto de camada desligada LIGA a camada e diz que
    // ligou, para o mapa não mudar sozinho sem explicação.
    const campo = document.getElementById('busca-mapa');
    const listaEl = document.getElementById('busca-lista');
    const contaEl = document.getElementById('busca-conta');
    const TETO_BUSCA = 30;

    const semAcento = (s) => s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();
    const nomeDe = (it, l) => (l === 'en' ? it.p.en : it.p.pt || it.p.en) || (it.rotulo ? it.rotulo[l] : '');
    // A chave de busca é montada uma vez só, na primeira tecla, e não a cada
    // tecla: normalizar 13.755 registros a cada letra digitada engasga o campo.
    let indexado = false;
    const indexar = () => {
      if (indexado) return;
      for (const it of indiceBusca) {
        it.chave = semAcento([it.p.pt, it.p.en, it.rotulo?.pt, it.rotulo?.en].filter(Boolean).join(' '));
      }
      indexado = true;
    };

    let achadosAtuais = [];
    const escreverConta = (pt, en) => {
      contaEl.dataset.rotPt = pt;
      contaEl.dataset.rotEn = en;
      contaEl.textContent = idioma() === 'en' ? en : pt;
    };

    function irPara(it) {
      const onde = it.nosso ? '#filtros' : '#filtros-paldb';
      const caixa = document.querySelector(`${onde} input[value="${it.camada}"]`);
      let ligou = false;
      if (caixa && !caixa.checked) {
        caixa.checked = true;
        caixa.dispatchEvent(new Event('change', { bubbles: true }));
        ligou = true;
      }
      mapa.setView(it.marcador.getLatLng(), Math.min(NATIVO, 3));
      // Camada nossa desligada pelo overlay não tem marcador no mapa, e mandar
      // abrir popup nela não faz nada em silêncio. Melhor não prometer.
      if (it.marcador._map) it.marcador.openPopup();
      if (ligou) escreverConta(rotBusca.pt.ligou, rotBusca.en.ligou);
    }

    function pintarAchados() {
      const l = idioma();
      listaEl.replaceChildren();
      for (const it of achadosAtuais.slice(0, TETO_BUSCA)) {
        const li = document.createElement('li');
        const bt = document.createElement('button');
        bt.type = 'button';
        const ponto = document.createElement('span');
        ponto.className = 'ponto';
        ponto.style.background = it.cor;
        const nome = document.createElement('span');
        nome.className = 'nome';
        nome.textContent = nomeDe(it, l) || (it.rotulo ? it.rotulo[l] : '');
        const qual = document.createElement('span');
        qual.className = 'qual';
        const rot = it.rotulo ? it.rotulo[l] : '';
        qual.textContent = typeof it.p.lv === 'number' ? `${rot} · ${rotBusca[l].nivel} ${it.p.lv}` : rot;
        const onde = document.createElement('span');
        onde.className = 'onde';
        onde.textContent = `${it.p.x}, ${it.p.y}`;
        // Os quatro pedaços são separados por espaço no visual, e por nada
        // nenhum no texto que o leitor de tela lê. O aria-label existe para o
        // botão ser anunciado como frase, e não como palavras coladas.
        bt.setAttribute('aria-label', [nome.textContent, qual.textContent, onde.textContent].filter(Boolean).join(', '));
        bt.append(ponto, nome, qual, onde);
        bt.addEventListener('click', () => irPara(it));
        li.appendChild(bt);
        listaEl.appendChild(li);
      }
    }

    function buscar() {
      const cru = campo.value.trim();
      if (!cru) {
        achadosAtuais = [];
        listaEl.replaceChildren();
        escreverConta('', '');
        return;
      }
      if (cru.length < 2) {
        achadosAtuais = [];
        listaEl.replaceChildren();
        escreverConta(rotBusca.pt.curta, rotBusca.en.curta);
        return;
      }
      indexar();
      const alvo = semAcento(cru);
      const l = idioma();
      achadosAtuais = indiceBusca.filter((it) => it.chave.includes(alvo));
      // Os nossos vêm primeiro: são 35 anotados à mão contra 13.755 importados,
      // e é neles que este grupo mexe.
      achadosAtuais.sort((a, b) =>
        (b.nosso - a.nosso) || nomeDe(a, l).localeCompare(nomeDe(b, l), 'pt-BR'));
      pintarAchados();
      const n = achadosAtuais.length;
      if (!n) escreverConta(rotBusca.pt.nada, rotBusca.en.nada);
      else if (n > TETO_BUSCA) {
        escreverConta(
          rotBusca.pt.corte.replace('{n}', n).replace('{m}', TETO_BUSCA),
          rotBusca.en.corte.replace('{n}', n).replace('{m}', TETO_BUSCA),
        );
      } else {
        escreverConta(rotBusca.pt.conta.replace('{n}', n), rotBusca.en.conta.replace('{n}', n));
      }
    }

    let relogioBusca = null;
    campo.addEventListener('input', () => {
      clearTimeout(relogioBusca);
      relogioBusca = setTimeout(buscar, 120);
    });
    campo.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      e.preventDefault();
      clearTimeout(relogioBusca);
      buscar();
      if (achadosAtuais.length) irPara(achadosAtuais[0]);
    });
    document.addEventListener('idioma:mudou', () => { if (achadosAtuais.length) pintarAchados(); });

    // Chegada por link: /mapa/?busca=Faleris%20Aqua
    //
    // A ficha de Pal liga para cá quando o Pal tem marcador nomeado, e são 137
    // dos 299. Sem isto o link abriria o mapa inteiro e deixaria a pessoa
    // procurando à mão, que é o mesmo defeito que a F11 corrigiu nos links dos
    // guias: cair no topo não é responder onde.
    //
    // Reaproveita a busca que já existe em vez de abrir um caminho próprio,
    // porque é ela que sabe ligar a camada desligada antes de abrir o popup.
    const pedido = new URLSearchParams(location.search).get('busca');
    if (pedido) {
      campo.value = pedido;
      buscar();
      if (achadosAtuais.length) irPara(achadosAtuais[0]);
    }

    // --- leitura de coordenada ---
    // Guarda os dois idiomas junto do texto: sem isso, trocar de idioma depois
    // de mexer no mapa devolvia a frase inicial e apagava a coordenada lida.
    const saida = document.getElementById('coord');
    const escrever = (pt, en) => {
      saida.dataset.rotPt = pt;
      saida.dataset.rotEn = en;
      saida.textContent = document.documentElement.dataset.idioma === 'en' ? en : pt;
    };
    mapa.on('mousemove', (e) => {
      const [x, y] = doLatLng(e.latlng);
      const cd = `${Math.round(x)}, ${Math.round(y)}`;
      escrever(`${rotCoord.pt.atual}: ${cd}`, `${rotCoord.en.atual}: ${cd}`);
    });
    mapa.on('click', (e) => {
      const [x, y] = doLatLng(e.latlng);
      const cd = `${Math.round(x)}, ${Math.round(y)}`;
      escrever(
        `${rotCoord.pt.clicado}: ${cd}. Copie para adicionar um ponto no mapa.json`,
        `${rotCoord.en.clicado}: ${cd}`,
      );
    });
  });
</script>
